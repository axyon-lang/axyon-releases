# Mixed-precision accumulation for tensor reductions and matmul (issue #474).
#
# f16/bf16 inputs accumulate in f32 by default and are rounded once to the
# input type at the end. `[acc]` / `[acc, out]` type arguments select the
# accumulator and output types explicitly; `acc` must represent every input
# value exactly (otherwise AX0576), and narrowing is never implicit.
#
# Reference values (computed by the compiler's accumulation-type tests):
#   sum of 4096 x 1.0 :  f32 accumulator -> 4096.0,  f16 accumulator -> 2048.0
#   [2048, 1, -2048, 1]: f32 accumulator -> 2.0,     f16 accumulator -> 1.0
#   f16 256.0 * 256.0 :  formed in f32 -> 65536.0 (not rounded to f16 = inf)
#
# rejected (AX0576): narrowing accumulator
#   let bad: Tensor[f16] = T.sum[f16](T.ones[f32]([4]))

import std.tensor as T

@host
def main() -> i32:
    # Tensors are moved by each call, so every use gets a fresh operand.
    let exact: Tensor[f16] = T.sum(T.ones[f16]([4096]))          # f32 accumulate -> 4096
    let stalled: Tensor[f16] = T.sum[f16](T.ones[f16]([4096]))   # f16 accumulate -> 2048
    let wide: Tensor[f32] = T.sum[f32](T.ones[f16]([4096]))      # f32 accumulate and result

    let c: Tensor[f16, (2, 4)] = T.matmul(T.ones[f16]([2, 3]), T.ones[f16]([3, 4]))
    let d: Tensor[f32, (2, 4)] = T.matmul[f32](T.ones[f16]([2, 3]), T.ones[f16]([3, 4]))
    let e: Tensor[f16, (2, 4)] = T.matmul[f64, f16](T.ones[f16]([2, 3]), T.ones[f16]([3, 4]))

    # Consume the results: a wrong accumulator makes the example exit non-zero.
    # Early `return`s next to tensor ops and `println!` are fine: the emitter
    # merges them into one exit block (#1268).
    let be: Buffer[f16, ()] = tensor_materialize(exact)
    let bs: Buffer[f16, ()] = tensor_materialize(stalled)
    let bw: Buffer[f32, ()] = tensor_materialize(wide)
    let ve: f16 = buffer_get(be)
    let vs: f16 = buffer_get(bs)
    let vw: f32 = buffer_get(bw)
    let bc: Buffer[f16, (2, 4)] = tensor_materialize(c)
    let bd: Buffer[f32, (2, 4)] = tensor_materialize(d)
    let be2: Buffer[f16, (2, 4)] = tensor_materialize(e)
    let vc: f16 = buffer_get(bc, 1, 3)
    let vd: f32 = buffer_get(bd, 1, 3)
    let vf: f16 = buffer_get(be2, 1, 3)

    if (ve as f64) != 4096.0_f64:
        println!("mixed precision demo: check 1 failed")
        return 1
    if (vs as f64) != 2048.0_f64:
        println!("mixed precision demo: check 2 failed")
        return 2
    if (vw as f64) != 4096.0_f64:
        println!("mixed precision demo: check 3 failed")
        return 3
    if (vc as f64) != 3.0_f64 or (vd as f64) != 3.0_f64 or (vf as f64) != 3.0_f64:
        println!("mixed precision demo: check 4 failed")
        return 4

    println!("mixed precision demo: all accumulator checks passed")
    return 0
