# 5-point Laplacian stencil (issue #1704): `T.laplacian5(a)` lowers to one
# all-parallel `linalg.generic` over shifted views of `a` (the opt-in MLIR
# Transform script `tile_stencil_2d` can tile and vectorize it).
# Interior points are ((n + s) + (w + e)) - 4 * c; boundary points are copied
# from the input. The scalar reference below uses the same association order,
# so the results are bit-identical.

import std.tensor as T

def reference(a: Tensor[f64, (6, 9)]) -> Tensor[f64, (6, 9)]:
    let mut out: Tensor[f64, (6, 9)] = T.zeros([6, 9])
    for i: i64 in range(0, 6):
        for j: i64 in range(0, 9):
            out[i, j] = a[i, j]
    for i: i64 in range(1, 5):
        for j: i64 in range(1, 8):
            let ns: f64 = a[i - 1, j] + a[i + 1, j]
            let we: f64 = a[i, j - 1] + a[i, j + 1]
            out[i, j] = (ns + we) - 4.0 * a[i, j]
    return out

def main() -> i32:
    let mut a: Tensor[f64, (6, 9)] = T.zeros([6, 9])
    for i: i64 in range(0, 6):
        for j: i64 in range(0, 9):
            a[i, j] = ((i * 7 + j * 13) % 17) as f64 * 0.37 + 0.1
    let got: Tensor[f64, (6, 9)] = T.laplacian5(a)
    let want: Tensor[f64, (6, 9)] = reference(a)
    let mut mismatches: i64 = 0
    for i: i64 in range(0, 6):
        for j: i64 in range(0, 9):
            if got[i, j] != want[i, j]:
                mismatches = mismatches + 1
    println!("mismatches = {mismatches}")
    assert!(mismatches == 0, "laplacian5 must match the scalar reference")
    return 0
