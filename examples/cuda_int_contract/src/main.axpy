    return 0

# Op `op` in u64, truncated: independent of the 16-bit lowering.
def wide_u16(op: i64, x: u16, y: u16) -> u16:
    let X: u64 = x as u64
    let Y: u64 = y as u64
    if op == 0:
        return (X + Y) as u16
    if op == 1:
        return (X - Y) as u16
    if op == 2:
        return (X * Y) as u16
    if op == 3:
        return (X & Y) as u16
    if op == 4:
        return (X | Y) as u16
    if op == 5:
        return (X ^ Y) as u16
    if op == 6:
        return (X << ((y & 15) as u64)) as u16
    if op == 7:
        return (X >> ((y & 15) as u64)) as u16
    if op == 8:
        return (X << ((y & 15) as u64)) as u16
    if op == 9:
        return (X >> ((y & 15) as u64)) as u16
    if op == 10:
        return (X << 3) as u16
    if op == 11:
        return (X >> 3) as u16
    if op == 12:
        return (X / 7) as u16
    if op == 13:
        return (X % 7) as u16
    if op == 14:
        return (X // 7) as u16
    if op == 15:
        return (X / 8) as u16
    if op == 16:
        return (X % 8) as u16
    if op == 17:
        return (X // 8) as u16
    if op == 18:
        return (X / 3) as u16
    if op == 19:
        return (X % 3) as u16
    if op == 20:
        return (X // 3) as u16
    if op == 21:
        return (X / 65535) as u16
    if op == 22:
        return (~X) as u16
    return 0

def check_u16() -> i64:
    let mut ha: Buffer[u16, (512,)] = buffer_alloc([512])
    let mut hb: Buffer[u16, (512,)] = buffer_alloc([512])
    let mut n: i64 = 0
    for p: i64 in range(N_U16):
        for q: i64 in range(N_U16):
            buffer_set(ha, n, val_u16(p))
            buffer_set(hb, n, val_u16(q))
            n = n + 1
    let da: Buffer[u16, (512,), device_global] = buffer_to_device(ha)
    let db: Buffer[u16, (512,), device_global] = buffer_to_device(hb)
    let zo: Buffer[u16, (11776,)] = buffer_alloc([11776])
    let mut dout: Buffer[u16, (11776,), device_global] = buffer_to_device(zo)
    let mut dcmp: Buffer[i32, (512,), device_global] = buffer_to_device(fill_i32())
    gpu_launch(int_u16, blocks_for(n), BLOCK, n, &da, &db, &mut dout, &mut dcmp)
    let got: Buffer[u16, (11776,)] = buffer_to_host(dout)
    let gotc: Buffer[i32, (512,)] = buffer_to_host(dcmp)
    let mut bad: i64 = 0
    let mut i: i64 = 0
    for p: i64 in range(N_U16):
        for q: i64 in range(N_U16):
            let x: u16 = val_u16(p)
            let y: u16 = val_u16(q)
            for op: i64 in range(23):
                let g: u16 = buffer_get(got, op * 512 + i)
                let r: u16 = ref_u16(op, x, y)
                if g != r:
                    bad = bad + report("u16", op, i, g as i64, r as i64)
                if r != wide_u16(op, x, y):
                    bad = bad + report("u16 oracle", op, i, r as i64, wide_u16(op, x, y) as i64)
            let c: i32 = buffer_get(gotc, i)
            if c != compare_bits_host_u16(x, y):
                bad = bad + report("u16 compare", 99, i, c as i64, compare_bits_host_u16(x, y) as i64)
            i = i + 1
    return bad

# ---- u32: 16 values, every pair ----

const N_U32: i64 = 16

def val_u32(k: i64) -> u32:
    let mut v: u64 = 0
    if k == 0:
        v = 0
    elif k == 1:
        v = 1
    elif k == 2:
        v = 2
    elif k == 3:
        v = 3
    elif k == 4:
        v = 5
    elif k == 5:
        v = 31
    elif k == 6:
        v = 32
    elif k == 7:
        v = 33
    elif k == 8:
        v = 67
    elif k == 9:
        v = 4294967295
    elif k == 10:
        v = 4294967294
    elif k == 11:
        v = 2147483648
    elif k == 12:
        v = 2147483647
    elif k == 13:
        v = 1515870810
    elif k == 14:
        v = 2779096485
    elif k == 15:
        v = 100
    return v as u32

@gpu(entry)
def int_u32(n: i64, a: &Buffer[u32, (512,), device_global], b: &Buffer[u32, (512,), device_global], out: &mut Buffer[u32, (11776,), device_global], cmp: &mut Buffer[i32, (512,), device_global]) -> None:
    let i: i64 = gpu_block_id(0) * gpu_block_dim(0) + gpu_thread_id(0)
    if i < n:
        let x: u32 = buffer_get(a, i)
        let y: u32 = buffer_get(b, i)
        buffer_set(out, i, x + y)
        buffer_set(out, 512 + i, x - y)
        buffer_set(out, 1024 + i, x * y)
        buffer_set(out, 1536 + i, x & y)
        buffer_set(out, 2048 + i, x | y)
        buffer_set(out, 2560 + i, x ^ y)
        buffer_set(out, 3072 + i, x << y)
        buffer_set(out, 3584 + i, x >> y)
        buffer_set(out, 4096 + i, x << (y & 31))
        buffer_set(out, 4608 + i, x >> (y & 31))
        buffer_set(out, 5120 + i, x << 35)
        buffer_set(out, 5632 + i, x >> 35)
        buffer_set(out, 6144 + i, x / 7)
        buffer_set(out, 6656 + i, x % 7)
        buffer_set(out, 7168 + i, x // 7)
        buffer_set(out, 7680 + i, x / 8)
        buffer_set(out, 8192 + i, x % 8)
        buffer_set(out, 8704 + i, x // 8)
        buffer_set(out, 9216 + i, x / 3)
        buffer_set(out, 9728 + i, x % 3)
        buffer_set(out, 10240 + i, x // 3)
        buffer_set(out, 10752 + i, x / 4294967295)
        buffer_set(out, 11264 + i, ~x)
        buffer_set(cmp, i, compare_bits_dev_u32(x, y))

@gpu
def compare_bits_dev_u32(x: u32, y: u32) -> i32:
    let mut c: i32 = 0
    if x < y:
        c = c + 1
    if x <= y:
        c = c + 2
    if x == y:
        c = c + 4
    if x != y:
        c = c + 8
    if x > y:
        c = c + 16
    if x >= y:
        c = c + 32
    return c

def compare_bits_host_u32(x: u32, y: u32) -> i32:
    let mut c: i32 = 0
    if x < y:
        c = c + 1
    if x <= y:
        c = c + 2
    if x == y:
        c = c + 4
    if x != y:
        c = c + 8
    if x > y:
        c = c + 16
    if x >= y:
        c = c + 32
    return c

# The strict host build of op `op`, the same expression as `int_u32`.
def ref_u32(op: i64, x: u32, y: u32) -> u32:
    if op == 0:
        return x + y
    if op == 1:
        return x - y
    if op == 2:
        return x * y
    if op == 3:
        return x & y
    if op == 4:
        return x | y
    if op == 5:
        return x ^ y
    if op == 6:
        return x << y
    if op == 7:
        return x >> y
    if op == 8:
        return x << (y & 31)
    if op == 9:
        return x >> (y & 31)
    if op == 10:
        return x << 35
    if op == 11:
        return x >> 35
    if op == 12:
        return x / 7
    if op == 13:
        return x % 7
    if op == 14:
        return x // 7
    if op == 15:
        return x / 8
    if op == 16:
        return x % 8
    if op == 17:
        return x // 8
    if op == 18:
        return x / 3
    if op == 19:
        return x % 3
    if op == 20:
        return x // 3
    if op == 21:
        return x / 4294967295
    if op == 22:
        return ~x
    return 0

# Op `op` in u64, truncated: independent of the 32-bit lowering.
def wide_u32(op: i64, x: u32, y: u32) -> u32:
    let X: u64 = x as u64
    let Y: u64 = y as u64
    if op == 0:
        return (X + Y) as u32
    if op == 1:
        return (X - Y) as u32
    if op == 2:
        return (X * Y) as u32
    if op == 3:
        return (X & Y) as u32
    if op == 4:
        return (X | Y) as u32
    if op == 5:
        return (X ^ Y) as u32
    if op == 6:
        return (X << ((y & 31) as u64)) as u32
    if op == 7:
        return (X >> ((y & 31) as u64)) as u32
    if op == 8:
        return (X << ((y & 31) as u64)) as u32
    if op == 9:
        return (X >> ((y & 31) as u64)) as u32
    if op == 10:
        return (X << 3) as u32
    if op == 11:
        return (X >> 3) as u32
    if op == 12:
        return (X / 7) as u32
    if op == 13:
        return (X % 7) as u32
    if op == 14:
        return (X // 7) as u32
    if op == 15:
        return (X / 8) as u32
    if op == 16:
        return (X % 8) as u32
    if op == 17:
        return (X // 8) as u32
    if op == 18:
        return (X / 3) as u32
    if op == 19:
        return (X % 3) as u32
    if op == 20:
        return (X // 3) as u32
    if op == 21:
        return (X / 4294967295) as u32
    if op == 22:
        return (~X) as u32
    return 0

def check_u32() -> i64:
    let mut ha: Buffer[u32, (512,)] = buffer_alloc([512])
    let mut hb: Buffer[u32, (512,)] = buffer_alloc([512])
    let mut n: i64 = 0
    for p: i64 in range(N_U32):
        for q: i64 in range(N_U32):
            buffer_set(ha, n, val_u32(p))
            buffer_set(hb, n, val_u32(q))
            n = n + 1
    let da: Buffer[u32, (512,), device_global] = buffer_to_device(ha)
    let db: Buffer[u32, (512,), device_global] = buffer_to_device(hb)
    let zo: Buffer[u32, (11776,)] = buffer_alloc([11776])
    let mut dout: Buffer[u32, (11776,), device_global] = buffer_to_device(zo)
    let mut dcmp: Buffer[i32, (512,), device_global] = buffer_to_device(fill_i32())
    gpu_launch(int_u32, blocks_for(n), BLOCK, n, &da, &db, &mut dout, &mut dcmp)
    let got: Buffer[u32, (11776,)] = buffer_to_host(dout)
    let gotc: Buffer[i32, (512,)] = buffer_to_host(dcmp)
    let mut bad: i64 = 0
    let mut i: i64 = 0
    for p: i64 in range(N_U32):
        for q: i64 in range(N_U32):
            let x: u32 = val_u32(p)
            let y: u32 = val_u32(q)
            for op: i64 in range(23):
                let g: u32 = buffer_get(got, op * 512 + i)
                let r: u32 = ref_u32(op, x, y)
                if g != r:
                    bad = bad + report("u32", op, i, g as i64, r as i64)
                if r != wide_u32(op, x, y):
                    bad = bad + report("u32 oracle", op, i, r as i64, wide_u32(op, x, y) as i64)
            let c: i32 = buffer_get(gotc, i)
            if c != compare_bits_host_u32(x, y):
                bad = bad + report("u32 compare", 99, i, c as i64, compare_bits_host_u32(x, y) as i64)
            i = i + 1
    return bad

