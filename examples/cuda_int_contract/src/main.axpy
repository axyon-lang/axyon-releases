# The strict host build of op `op`, the same expression as `int_u8`.
def ref_u8(op: i64, x: u8, y: u8) -> u8:
    if op == 0:
        return x + y
    if op == 1:
        return x - y
    if op == 2:
        return x * y
    if op == 3:
        return x & y
    if op == 4:
        return x | y
    if op == 5:
        return x ^ y
    if op == 6:
        return x << y
