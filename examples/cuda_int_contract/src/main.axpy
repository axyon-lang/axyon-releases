# The strict host build of op `op`, the same expression as `int_i32`.
def ref_i32(op: i64, x: i32, y: i32) -> i32:
    if op == 0:
        return x + y
    if op == 1:
        return x - y
    if op == 2:
        return x * y
    if op == 3:
        return x & y
    if op == 4:
        return x | y
    if op == 5:
        return x ^ y
    if op == 6:
        return x << y
    if op == 7:
        return x >> y
    if op == 8:
        return x << (y & 31)
    if op == 9:
        return x >> (y & 31)
    if op == 10:
        return x << 35
    if op == 11:
        return x >> 35
    if op == 12:
        return x / 7
    if op == 13:
        return x % 7
    if op == 14:
        return x // 7
    if op == 15:
        return x / 8
    if op == 16:
        return x % 8
    if op == 17:
        return x // 8
    if op == 18:
        return x / -3
    if op == 19:
        return x % -3
    if op == 20:
        return x // -3
    if op == 21:
        return x / -2147483648
    if op == 22:
        return ~x
    return 0

# Op `op` in i64, truncated: independent of the 32-bit lowering.
def wide_i32(op: i64, x: i32, y: i32) -> i32:
    let X: i64 = x as i64
    let Y: i64 = y as i64
    if op == 0:
        return (X + Y) as i32
    if op == 1:
        return (X - Y) as i32
    if op == 2:
        return (X * Y) as i32
    if op == 3:
        return (X & Y) as i32
    if op == 4:
        return (X | Y) as i32
    if op == 5:
        return (X ^ Y) as i32
    if op == 6:
        return (X << ((y & 31) as i64)) as i32
    if op == 7:
        return (X >> ((y & 31) as i64)) as i32
    if op == 8:
        return (X << ((y & 31) as i64)) as i32
    if op == 9:
        return (X >> ((y & 31) as i64)) as i32
    if op == 10:
        return (X << 3) as i32
    if op == 11:
        return (X >> 3) as i32
    if op == 12:
        return (X / 7) as i32
    if op == 13:
        return (X % 7) as i32
    if op == 14:
        return (X // 7) as i32
    if op == 15:
        return (X / 8) as i32
    if op == 16:
        return (X % 8) as i32
    if op == 17:
        return (X // 8) as i32
    if op == 18:
        return (X / -3) as i32
    if op == 19:
        return (X % -3) as i32
    if op == 20:
        return (X // -3) as i32
    if op == 21:
        return (X / -2147483648) as i32
    if op == 22:
        return (~X) as i32
    return 0

def check_i32() -> i64:
    let mut ha: Buffer[i32, (512,)] = buffer_alloc([512])
    let mut hb: Buffer[i32, (512,)] = buffer_alloc([512])
    let mut n: i64 = 0
    for p: i64 in range(N_I32):
        for q: i64 in range(N_I32):
            buffer_set(ha, n, val_i32(p))
            buffer_set(hb, n, val_i32(q))
            n = n + 1
    let da: Buffer[i32, (512,), device_global] = buffer_to_device(ha)
    let db: Buffer[i32, (512,), device_global] = buffer_to_device(hb)
    let zo: Buffer[i32, (11776,)] = buffer_alloc([11776])
    let mut dout: Buffer[i32, (11776,), device_global] = buffer_to_device(zo)
    let mut dcmp: Buffer[i32, (512,), device_global] = buffer_to_device(fill_i32())
    gpu_launch(int_i32, blocks_for(n), BLOCK, n, &da, &db, &mut dout, &mut dcmp)
    let got: Buffer[i32, (11776,)] = buffer_to_host(dout)
    let gotc: Buffer[i32, (512,)] = buffer_to_host(dcmp)
    let mut bad: i64 = 0
    let mut i: i64 = 0
    for p: i64 in range(N_I32):
        for q: i64 in range(N_I32):
            let x: i32 = val_i32(p)
            let y: i32 = val_i32(q)
            for op: i64 in range(23):
                let g: i32 = buffer_get(got, op * 512 + i)
                let r: i32 = ref_i32(op, x, y)
                if g != r:
                    bad = bad + report("i32", op, i, g as i64, r as i64)
                if r != wide_i32(op, x, y):
                    bad = bad + report("i32 oracle", op, i, r as i64, wide_i32(op, x, y) as i64)
            let c: i32 = buffer_get(gotc, i)
            if c != compare_bits_host_i32(x, y):
                bad = bad + report("i32 compare", 99, i, c as i64, compare_bits_host_i32(x, y) as i64)
            i = i + 1
    return bad

# ---- i64: 18 values, every pair ----

const N_I64: i64 = 18

def val_i64(k: i64) -> i64:
    let mut v: i64 = 0
    if k == 0:
        v = 0
    elif k == 1:
        v = 1
    elif k == 2:
        v = -1
    elif k == 3:
        v = 2
    elif k == 4:
        v = -2
    elif k == 5:
        v = 3
    elif k == 6:
        v = 5
    elif k == 7:
        v = -5
    elif k == 8:
        v = 63
    elif k == 9:
        v = 64
    elif k == 10:
        v = 65
    elif k == 11:
        v = 131
    elif k == 12:
        v = (-9223372036854775807 - 1)
    elif k == 13:
        v = -9223372036854775807
    elif k == 14:
        v = 9223372036854775807
    elif k == 15:
        v = 9223372036854775806
    elif k == 16:
        v = 6510615555426900570
    elif k == 17:
        v = -6510615555426900571
    return v as i64

@gpu(entry)
def int_i64(n: i64, a: &Buffer[i64, (512,), device_global], b: &Buffer[i64, (512,), device_global], out: &mut Buffer[i64, (11776,), device_global], cmp: &mut Buffer[i32, (512,), device_global]) -> None:
    let i: i64 = gpu_block_id(0) * gpu_block_dim(0) + gpu_thread_id(0)
    if i < n:
        let x: i64 = buffer_get(a, i)
        let y: i64 = buffer_get(b, i)
        buffer_set(out, i, x + y)
        buffer_set(out, 512 + i, x - y)
        buffer_set(out, 1024 + i, x * y)
        buffer_set(out, 1536 + i, x & y)
        buffer_set(out, 2048 + i, x | y)
        buffer_set(out, 2560 + i, x ^ y)
        buffer_set(out, 3072 + i, x << y)
        buffer_set(out, 3584 + i, x >> y)
        buffer_set(out, 4096 + i, x << (y & 63))
        buffer_set(out, 4608 + i, x >> (y & 63))
        buffer_set(out, 5120 + i, x << 67)
        buffer_set(out, 5632 + i, x >> 67)
        buffer_set(out, 6144 + i, x / 7)
        buffer_set(out, 6656 + i, x % 7)
        buffer_set(out, 7168 + i, x // 7)
        buffer_set(out, 7680 + i, x / 8)
        buffer_set(out, 8192 + i, x % 8)
        buffer_set(out, 8704 + i, x // 8)
        buffer_set(out, 9216 + i, x / -3)
        buffer_set(out, 9728 + i, x % -3)
        buffer_set(out, 10240 + i, x // -3)
        buffer_set(out, 10752 + i, x / -9223372036854775808)
        buffer_set(out, 11264 + i, ~x)
        buffer_set(cmp, i, compare_bits_dev_i64(x, y))

@gpu
def compare_bits_dev_i64(x: i64, y: i64) -> i32:
    let mut c: i32 = 0
    if x < y:
        c = c + 1
    if x <= y:
        c = c + 2
    if x == y:
        c = c + 4
    if x != y:
        c = c + 8
    if x > y:
        c = c + 16
    if x >= y:
        c = c + 32
    return c

def compare_bits_host_i64(x: i64, y: i64) -> i32:
    let mut c: i32 = 0
    if x < y:
        c = c + 1
    if x <= y:
        c = c + 2
    if x == y:
        c = c + 4
    if x != y:
        c = c + 8
    if x > y:
        c = c + 16
    if x >= y:
        c = c + 32
    return c

# The strict host build of op `op`, the same expression as `int_i64`.
def ref_i64(op: i64, x: i64, y: i64) -> i64:
    if op == 0:
        return x + y
    if op == 1:
        return x - y
    if op == 2:
        return x * y
    if op == 3:
        return x & y
    if op == 4:
        return x | y
    if op == 5:
        return x ^ y
    if op == 6:
        return x << y
    if op == 7:
        return x >> y
    if op == 8:
        return x << (y & 63)
    if op == 9:
        return x >> (y & 63)
    if op == 10:
        return x << 67
    if op == 11:
        return x >> 67
    if op == 12:
        return x / 7
    if op == 13:
        return x % 7
    if op == 14:
        return x // 7
    if op == 15:
        return x / 8
    if op == 16:
        return x % 8
    if op == 17:
        return x // 8
    if op == 18:
        return x / -3
    if op == 19:
        return x % -3
    if op == 20:
        return x // -3
    if op == 21:
        return x / -9223372036854775808
    if op == 22:
        return ~x
    return 0

def check_i64() -> i64:
    let mut ha: Buffer[i64, (512,)] = buffer_alloc([512])
    let mut hb: Buffer[i64, (512,)] = buffer_alloc([512])
    let mut n: i64 = 0
    for p: i64 in range(N_I64):
        for q: i64 in range(N_I64):
            buffer_set(ha, n, val_i64(p))
            buffer_set(hb, n, val_i64(q))
            n = n + 1
    let da: Buffer[i64, (512,), device_global] = buffer_to_device(ha)
    let db: Buffer[i64, (512,), device_global] = buffer_to_device(hb)
    let zo: Buffer[i64, (11776,)] = buffer_alloc([11776])
    let mut dout: Buffer[i64, (11776,), device_global] = buffer_to_device(zo)
    let mut dcmp: Buffer[i32, (512,), device_global] = buffer_to_device(fill_i32())
    gpu_launch(int_i64, blocks_for(n), BLOCK, n, &da, &db, &mut dout, &mut dcmp)
    let got: Buffer[i64, (11776,)] = buffer_to_host(dout)
    let gotc: Buffer[i32, (512,)] = buffer_to_host(dcmp)
    let mut bad: i64 = 0
    let mut i: i64 = 0
    for p: i64 in range(N_I64):
        for q: i64 in range(N_I64):
            let x: i64 = val_i64(p)
            let y: i64 = val_i64(q)
            for op: i64 in range(23):
                let g: i64 = buffer_get(got, op * 512 + i)
                let r: i64 = ref_i64(op, x, y)
                if g != r:
                    bad = bad + report("i64", op, i, g as i64, r as i64)
            let c: i32 = buffer_get(gotc, i)
            if c != compare_bits_host_i64(x, y):
                bad = bad + report("i64 compare", 99, i, c as i64, compare_bits_host_i64(x, y) as i64)
            i = i + 1
    return bad

