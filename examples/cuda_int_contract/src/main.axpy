# The strict host build of op `op`, the same expression as `int_u64`.
def ref_u64(op: i64, x: u64, y: u64) -> u64:
    if op == 0:
        return x + y
    if op == 1:
        return x - y
    if op == 2:
        return x * y
    if op == 3:
        return x & y
    if op == 4:
        return x | y
    if op == 5:
