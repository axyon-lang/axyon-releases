    if op == 12:
        return x / 7
    if op == 13:
        return x % 7
    if op == 14:
        return x // 7
    if op == 15:
        return x / 8
    if op == 16:
        return x % 8
    if op == 17:
        return x // 8
    if op == 18:
        return x / 3
    if op == 19:
        return x % 3
    if op == 20:
        return x // 3
    if op == 21:
        return x / 255
    if op == 22:
        return ~x
    return 0

# Op `op` in u64, truncated: independent of the 8-bit lowering.
def wide_u8(op: i64, x: u8, y: u8) -> u8:
    let X: u64 = x as u64
    let Y: u64 = y as u64
    if op == 0:
        return (X + Y) as u8
    if op == 1:
        return (X - Y) as u8
    if op == 2:
        return (X * Y) as u8
    if op == 3:
        return (X & Y) as u8
    if op == 4:
        return (X | Y) as u8
    if op == 5:
        return (X ^ Y) as u8
    if op == 6:
        return (X << ((y & 7) as u64)) as u8
    if op == 7:
        return (X >> ((y & 7) as u64)) as u8
    if op == 8:
        return (X << ((y & 7) as u64)) as u8
    if op == 9:
        return (X >> ((y & 7) as u64)) as u8
    if op == 10:
        return (X << 3) as u8
    if op == 11:
        return (X >> 3) as u8
    if op == 12:
        return (X / 7) as u8
    if op == 13:
        return (X % 7) as u8
    if op == 14:
        return (X // 7) as u8
    if op == 15:
        return (X / 8) as u8
    if op == 16:
        return (X % 8) as u8
    if op == 17:
        return (X // 8) as u8
    if op == 18:
        return (X / 3) as u8
    if op == 19:
        return (X % 3) as u8
    if op == 20:
        return (X // 3) as u8
    if op == 21:
        return (X / 255) as u8
    if op == 22:
        return (~X) as u8
    return 0

def check_u8() -> i64:
    let mut ha: Buffer[u8, (512,)] = buffer_alloc([512])
    let mut hb: Buffer[u8, (512,)] = buffer_alloc([512])
    let mut n: i64 = 0
    for p: i64 in range(N_U8):
        for q: i64 in range(N_U8):
            buffer_set(ha, n, val_u8(p))
            buffer_set(hb, n, val_u8(q))
            n = n + 1
    let da: Buffer[u8, (512,), device_global] = buffer_to_device(ha)
    let db: Buffer[u8, (512,), device_global] = buffer_to_device(hb)
    let zo: Buffer[u8, (11776,)] = buffer_alloc([11776])
    let mut dout: Buffer[u8, (11776,), device_global] = buffer_to_device(zo)
    let mut dcmp: Buffer[i32, (512,), device_global] = buffer_to_device(fill_i32())
    gpu_launch(int_u8, blocks_for(n), BLOCK, n, &da, &db, &mut dout, &mut dcmp)
    let got: Buffer[u8, (11776,)] = buffer_to_host(dout)
    let gotc: Buffer[i32, (512,)] = buffer_to_host(dcmp)
    let mut bad: i64 = 0
    let mut i: i64 = 0
    for p: i64 in range(N_U8):
        for q: i64 in range(N_U8):
            let x: u8 = val_u8(p)
            let y: u8 = val_u8(q)
            for op: i64 in range(23):
                let g: u8 = buffer_get(got, op * 512 + i)
                let r: u8 = ref_u8(op, x, y)
                if g != r:
                    bad = bad + report("u8", op, i, g as i64, r as i64)
                if r != wide_u8(op, x, y):
                    bad = bad + report("u8 oracle", op, i, r as i64, wide_u8(op, x, y) as i64)
            let c: i32 = buffer_get(gotc, i)
            if c != compare_bits_host_u8(x, y):
                bad = bad + report("u8 compare", 99, i, c as i64, compare_bits_host_u8(x, y) as i64)
            i = i + 1
    return bad

