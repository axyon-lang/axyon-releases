# The integer numeric contract on an NVIDIA GPU (issue #3098).
#
# GENERATED by gen.py; do not edit by hand. Run
#   python3 -I examples/cuda_int_contract/gen.py > examples/cuda_int_contract/src/main.axpy
#
# Every kernel runs on the device and every result is compared bit for bit
# with the strict host build of the same expression; for the 8-, 16- and
# 32-bit types and the conversions, the host result is also checked against
# an oracle computed another way (in a 64-bit type, or by explicit bounds),
# so a fault shared by the host and device lowering is caught too:
#
# 1. i8, i16, i32, i64, u8, u16, u32, u64, every pair of a special-value
#    table (0, +-1, shift amounts around the width, MIN/MAX and neighbours,
#    alternating bit patterns): `+ - *` (wrap: the debug overflow trap has no
#    device lowering, nvidia-profile §6), `& | ^ ~`, the six comparisons, and
#    shifts by any amount, including amounts >= the width and negative ones:
#    `x << y` is `x << (y & (BITS - 1))` in every profile (numeric contract
#    §5.4), also with a constant out-of-range amount.
# 2. Integer `/`, `%` and `//` by literal divisors (7, 8, -3 or 3, MIN or
#    MAX), whose traps the range analysis discharges: signed division
#    truncates toward zero and `//` floors. A divisor that may be zero, and a
#    signed divisor that may be -1 (`MIN / -1`), cannot be checked in device
#    code and is rejected at compile time (AX0626), never lowered unguarded;
#    `cuda_int_contract_3098.rs` checks those rejections.
# 3. float -> int `as` from f32 and f64 to every integer type at and around
#    every bound: truncate toward zero, saturate, NaN -> 0.
# 4. No contraction: `x * y + z` in f32 and f64 is two roundings, on inputs
#    where a fused multiply-add gives a different result.

const BLOCK: i64 = 128

def blocks_for(n: i64) -> i64:
    return (n + BLOCK - 1) / BLOCK

# Print a mismatch; returns 1.
def report(what: str, op: i64, i: i64, got: i64, want: i64) -> i64:
    println!("{what} mismatch: op {op} lane {i}: got {got}, want {want}")
    return 1

# Output sentinels, so an unwritten lane cannot pass by accident.
def fill_i32() -> Buffer[i32, (512,)]:
    let mut b: Buffer[i32, (512,)] = buffer_alloc([512])
    for i: i64 in range(512):
        buffer_set(b, i, -7)
    return b

def fill_i64() -> Buffer[i64, (512,)]:
    let mut b: Buffer[i64, (512,)] = buffer_alloc([512])
    for i: i64 in range(512):
        buffer_set(b, i, -7)
    return b

# ---- i8: 18 values, every pair ----

const N_I8: i64 = 18

def val_i8(k: i64) -> i8:
    let mut v: i64 = 0
    if k == 0:
        v = 0
    elif k == 1:
        v = 1
    elif k == 2:
        v = -1
    elif k == 3:
        v = 2
    elif k == 4:
        v = -2
    elif k == 5:
        v = 3
    elif k == 6:
        v = 5
    elif k == 7:
        v = -5
    elif k == 8:
        v = 7
    elif k == 9:
        v = 8
    elif k == 10:
        v = 9
    elif k == 11:
        v = 19
    elif k == 12:
        v = -128
    elif k == 13:
        v = -127
    elif k == 14:
        v = 127
    elif k == 15:
        v = 126
    elif k == 16:
        v = 90
    elif k == 17:
        v = -91
    return v as i8

@gpu(entry)
def int_i8(n: i64, a: &Buffer[i8, (512,), device_global], b: &Buffer[i8, (512,), device_global], out: &mut Buffer[i8, (11776,), device_global], cmp: &mut Buffer[i32, (512,), device_global]) -> None:
    let i: i64 = gpu_block_id(0) * gpu_block_dim(0) + gpu_thread_id(0)
    if i < n:
        let x: i8 = buffer_get(a, i)
        let y: i8 = buffer_get(b, i)
        buffer_set(out, i, x + y)
        buffer_set(out, 512 + i, x - y)
        buffer_set(out, 1024 + i, x * y)
        buffer_set(out, 1536 + i, x & y)
        buffer_set(out, 2048 + i, x | y)
        buffer_set(out, 2560 + i, x ^ y)
        buffer_set(out, 3072 + i, x << y)
        buffer_set(out, 3584 + i, x >> y)
        buffer_set(out, 4096 + i, x << (y & 7))
        buffer_set(out, 4608 + i, x >> (y & 7))
        buffer_set(out, 5120 + i, x << 11)
        buffer_set(out, 5632 + i, x >> 11)
        buffer_set(out, 6144 + i, x / 7)
        buffer_set(out, 6656 + i, x % 7)
        buffer_set(out, 7168 + i, x // 7)
        buffer_set(out, 7680 + i, x / 8)
        buffer_set(out, 8192 + i, x % 8)
        buffer_set(out, 8704 + i, x // 8)
        buffer_set(out, 9216 + i, x / -3)
        buffer_set(out, 9728 + i, x % -3)
        buffer_set(out, 10240 + i, x // -3)
        buffer_set(out, 10752 + i, x / -128)
        buffer_set(out, 11264 + i, ~x)
        buffer_set(cmp, i, compare_bits_dev_i8(x, y))

@gpu
def compare_bits_dev_i8(x: i8, y: i8) -> i32:
    let mut c: i32 = 0
    if x < y:
        c = c + 1
    if x <= y:
        c = c + 2
    if x == y:
        c = c + 4
    if x != y:
        c = c + 8
    if x > y:
        c = c + 16
    if x >= y:
        c = c + 32
    return c

def compare_bits_host_i8(x: i8, y: i8) -> i32:
    let mut c: i32 = 0
    if x < y:
        c = c + 1
    if x <= y:
        c = c + 2
    if x == y:
        c = c + 4
    if x != y:
        c = c + 8
    if x > y:
        c = c + 16
    if x >= y:
        c = c + 32
    return c

# The strict host build of op `op`, the same expression as `int_i8`.
def ref_i8(op: i64, x: i8, y: i8) -> i8:
    if op == 0:
        return x + y
    if op == 1:
        return x - y
    if op == 2:
        return x * y
    if op == 3:
        return x & y
    if op == 4:
        return x | y
    if op == 5:
        return x ^ y
    if op == 6:
        return x << y
    if op == 7:
        return x >> y
    if op == 8:
        return x << (y & 7)
    if op == 9:
        return x >> (y & 7)
    if op == 10:
        return x << 11
    if op == 11:
        return x >> 11
    if op == 12:
        return x / 7
    if op == 13:
        return x % 7
    if op == 14:
        return x // 7
    if op == 15:
        return x / 8
    if op == 16:
        return x % 8
    if op == 17:
        return x // 8
    if op == 18:
        return x / -3
    if op == 19:
        return x % -3
    if op == 20:
        return x // -3
    if op == 21:
        return x / -128
    if op == 22:
        return ~x
    return 0

# Op `op` in i64, truncated: independent of the 8-bit lowering.
def wide_i8(op: i64, x: i8, y: i8) -> i8:
    let X: i64 = x as i64
    let Y: i64 = y as i64
    if op == 0:
        return (X + Y) as i8
    if op == 1:
        return (X - Y) as i8
    if op == 2:
        return (X * Y) as i8
    if op == 3:
        return (X & Y) as i8
    if op == 4:
        return (X | Y) as i8
    if op == 5:
        return (X ^ Y) as i8
    if op == 6:
        return (X << ((y & 7) as i64)) as i8
    if op == 7:
        return (X >> ((y & 7) as i64)) as i8
    if op == 8:
        return (X << ((y & 7) as i64)) as i8
    if op == 9:
        return (X >> ((y & 7) as i64)) as i8
    if op == 10:
        return (X << 3) as i8
    if op == 11:
        return (X >> 3) as i8
    if op == 12:
        return (X / 7) as i8
    if op == 13:
        return (X % 7) as i8
    if op == 14:
        return (X // 7) as i8
    if op == 15:
        return (X / 8) as i8
    if op == 16:
        return (X % 8) as i8
    if op == 17:
        return (X // 8) as i8
    if op == 18:
        return (X / -3) as i8
    if op == 19:
        return (X % -3) as i8
    if op == 20:
        return (X // -3) as i8
    if op == 21:
        return (X / -128) as i8
    if op == 22:
        return (~X) as i8
    return 0

def check_i8() -> i64:
    let mut ha: Buffer[i8, (512,)] = buffer_alloc([512])
    let mut hb: Buffer[i8, (512,)] = buffer_alloc([512])
    let mut n: i64 = 0
    for p: i64 in range(N_I8):
        for q: i64 in range(N_I8):
            buffer_set(ha, n, val_i8(p))
            buffer_set(hb, n, val_i8(q))
            n = n + 1
    let da: Buffer[i8, (512,), device_global] = buffer_to_device(ha)
    let db: Buffer[i8, (512,), device_global] = buffer_to_device(hb)
    let zo: Buffer[i8, (11776,)] = buffer_alloc([11776])
    let mut dout: Buffer[i8, (11776,), device_global] = buffer_to_device(zo)
    let mut dcmp: Buffer[i32, (512,), device_global] = buffer_to_device(fill_i32())
    gpu_launch(int_i8, blocks_for(n), BLOCK, n, &da, &db, &mut dout, &mut dcmp)
    let got: Buffer[i8, (11776,)] = buffer_to_host(dout)
    let gotc: Buffer[i32, (512,)] = buffer_to_host(dcmp)
    let mut bad: i64 = 0
    let mut i: i64 = 0
    for p: i64 in range(N_I8):
        for q: i64 in range(N_I8):
            let x: i8 = val_i8(p)
            let y: i8 = val_i8(q)
            for op: i64 in range(23):
                let g: i8 = buffer_get(got, op * 512 + i)
                let r: i8 = ref_i8(op, x, y)
                if g != r:
                    bad = bad + report("i8", op, i, g as i64, r as i64)
                if r != wide_i8(op, x, y):
                    bad = bad + report("i8 oracle", op, i, r as i64, wide_i8(op, x, y) as i64)
            let c: i32 = buffer_get(gotc, i)
            if c != compare_bits_host_i8(x, y):
                bad = bad + report("i8 compare", 99, i, c as i64, compare_bits_host_i8(x, y) as i64)
            i = i + 1
    return bad

# ---- i16: 18 values, every pair ----

const N_I16: i64 = 18

def val_i16(k: i64) -> i16:
    let mut v: i64 = 0
    if k == 0:
        v = 0
    elif k == 1:
        v = 1
    elif k == 2:
        v = -1
    elif k == 3:
        v = 2
    elif k == 4:
        v = -2
    elif k == 5:
        v = 3
    elif k == 6:
        v = 5
    elif k == 7:
        v = -5
    elif k == 8:
        v = 15
    elif k == 9:
        v = 16
    elif k == 10:
        v = 17
    elif k == 11:
        v = 35
    elif k == 12:
        v = -32768
    elif k == 13:
        v = -32767
    elif k == 14:
        v = 32767
    elif k == 15:
        v = 32766
    elif k == 16:
        v = 23130
    elif k == 17:
        v = -23131
    return v as i16

@gpu(entry)
def int_i16(n: i64, a: &Buffer[i16, (512,), device_global], b: &Buffer[i16, (512,), device_global], out: &mut Buffer[i16, (11776,), device_global], cmp: &mut Buffer[i32, (512,), device_global]) -> None:
    let i: i64 = gpu_block_id(0) * gpu_block_dim(0) + gpu_thread_id(0)
    if i < n:
        let x: i16 = buffer_get(a, i)
        let y: i16 = buffer_get(b, i)
        buffer_set(out, i, x + y)
        buffer_set(out, 512 + i, x - y)
        buffer_set(out, 1024 + i, x * y)
        buffer_set(out, 1536 + i, x & y)
        buffer_set(out, 2048 + i, x | y)
        buffer_set(out, 2560 + i, x ^ y)
        buffer_set(out, 3072 + i, x << y)
        buffer_set(out, 3584 + i, x >> y)
        buffer_set(out, 4096 + i, x << (y & 15))
        buffer_set(out, 4608 + i, x >> (y & 15))
        buffer_set(out, 5120 + i, x << 19)
        buffer_set(out, 5632 + i, x >> 19)
        buffer_set(out, 6144 + i, x / 7)
        buffer_set(out, 6656 + i, x % 7)
        buffer_set(out, 7168 + i, x // 7)
        buffer_set(out, 7680 + i, x / 8)
        buffer_set(out, 8192 + i, x % 8)
        buffer_set(out, 8704 + i, x // 8)
        buffer_set(out, 9216 + i, x / -3)
        buffer_set(out, 9728 + i, x % -3)
        buffer_set(out, 10240 + i, x // -3)
        buffer_set(out, 10752 + i, x / -32768)
        buffer_set(out, 11264 + i, ~x)
        buffer_set(cmp, i, compare_bits_dev_i16(x, y))

@gpu
def compare_bits_dev_i16(x: i16, y: i16) -> i32:
    let mut c: i32 = 0
    if x < y:
        c = c + 1
    if x <= y:
        c = c + 2
    if x == y:
        c = c + 4
    if x != y:
        c = c + 8
    if x > y:
        c = c + 16
    if x >= y:
        c = c + 32
    return c

def compare_bits_host_i16(x: i16, y: i16) -> i32:
    let mut c: i32 = 0
    if x < y:
        c = c + 1
    if x <= y:
        c = c + 2
    if x == y:
        c = c + 4
    if x != y:
        c = c + 8
    if x > y:
        c = c + 16
    if x >= y:
        c = c + 32
    return c

# The strict host build of op `op`, the same expression as `int_i16`.
def ref_i16(op: i64, x: i16, y: i16) -> i16:
    if op == 0:
        return x + y
    if op == 1:
        return x - y
    if op == 2:
        return x * y
    if op == 3:
        return x & y
    if op == 4:
        return x | y
    if op == 5:
        return x ^ y
    if op == 6:
        return x << y
    if op == 7:
        return x >> y
    if op == 8:
        return x << (y & 15)
    if op == 9:
        return x >> (y & 15)
    if op == 10:
        return x << 19
    if op == 11:
        return x >> 19
    if op == 12:
        return x / 7
    if op == 13:
        return x % 7
    if op == 14:
        return x // 7
    if op == 15:
        return x / 8
    if op == 16:
        return x % 8
    if op == 17:
        return x // 8
    if op == 18:
        return x / -3
    if op == 19:
        return x % -3
    if op == 20:
        return x // -3
    if op == 21:
        return x / -32768
    if op == 22:
        return ~x
    return 0

# Op `op` in i64, truncated: independent of the 16-bit lowering.
def wide_i16(op: i64, x: i16, y: i16) -> i16:
    let X: i64 = x as i64
    let Y: i64 = y as i64
    if op == 0:
        return (X + Y) as i16
    if op == 1:
        return (X - Y) as i16
    if op == 2:
        return (X * Y) as i16
    if op == 3:
        return (X & Y) as i16
    if op == 4:
        return (X | Y) as i16
    if op == 5:
        return (X ^ Y) as i16
    if op == 6:
        return (X << ((y & 15) as i64)) as i16
    if op == 7:
        return (X >> ((y & 15) as i64)) as i16
    if op == 8:
        return (X << ((y & 15) as i64)) as i16
    if op == 9:
        return (X >> ((y & 15) as i64)) as i16
    if op == 10:
        return (X << 3) as i16
    if op == 11:
        return (X >> 3) as i16
    if op == 12:
        return (X / 7) as i16
    if op == 13:
        return (X % 7) as i16
    if op == 14:
        return (X // 7) as i16
    if op == 15:
        return (X / 8) as i16
    if op == 16:
        return (X % 8) as i16
    if op == 17:
        return (X // 8) as i16
    if op == 18:
        return (X / -3) as i16
    if op == 19:
        return (X % -3) as i16
    if op == 20:
        return (X // -3) as i16
    if op == 21:
        return (X / -32768) as i16
    if op == 22:
        return (~X) as i16
    return 0

def check_i16() -> i64:
    let mut ha: Buffer[i16, (512,)] = buffer_alloc([512])
    let mut hb: Buffer[i16, (512,)] = buffer_alloc([512])
    let mut n: i64 = 0
    for p: i64 in range(N_I16):
        for q: i64 in range(N_I16):
            buffer_set(ha, n, val_i16(p))
            buffer_set(hb, n, val_i16(q))
            n = n + 1
    let da: Buffer[i16, (512,), device_global] = buffer_to_device(ha)
    let db: Buffer[i16, (512,), device_global] = buffer_to_device(hb)
    let zo: Buffer[i16, (11776,)] = buffer_alloc([11776])
    let mut dout: Buffer[i16, (11776,), device_global] = buffer_to_device(zo)
    let mut dcmp: Buffer[i32, (512,), device_global] = buffer_to_device(fill_i32())
    gpu_launch(int_i16, blocks_for(n), BLOCK, n, &da, &db, &mut dout, &mut dcmp)
    let got: Buffer[i16, (11776,)] = buffer_to_host(dout)
    let gotc: Buffer[i32, (512,)] = buffer_to_host(dcmp)
    let mut bad: i64 = 0
    let mut i: i64 = 0
    for p: i64 in range(N_I16):
        for q: i64 in range(N_I16):
            let x: i16 = val_i16(p)
            let y: i16 = val_i16(q)
            for op: i64 in range(23):
                let g: i16 = buffer_get(got, op * 512 + i)
                let r: i16 = ref_i16(op, x, y)
                if g != r:
                    bad = bad + report("i16", op, i, g as i64, r as i64)
                if r != wide_i16(op, x, y):
                    bad = bad + report("i16 oracle", op, i, r as i64, wide_i16(op, x, y) as i64)
            let c: i32 = buffer_get(gotc, i)
            if c != compare_bits_host_i16(x, y):
                bad = bad + report("i16 compare", 99, i, c as i64, compare_bits_host_i16(x, y) as i64)
            i = i + 1
    return bad

# ---- i32: 18 values, every pair ----

const N_I32: i64 = 18

def val_i32(k: i64) -> i32:
    let mut v: i64 = 0
    if k == 0:
        v = 0
    elif k == 1:
        v = 1
    elif k == 2:
        v = -1
    elif k == 3:
        v = 2
    elif k == 4:
        v = -2
    elif k == 5:
        v = 3
    elif k == 6:
        v = 5
    elif k == 7:
        v = -5
    elif k == 8:
        v = 31
    elif k == 9:
        v = 32
    elif k == 10:
        v = 33
    elif k == 11:
        v = 67
    elif k == 12:
        v = -2147483648
    elif k == 13:
        v = -2147483647
    elif k == 14:
        v = 2147483647
    elif k == 15:
        v = 2147483646
    elif k == 16:
        v = 1515870810
    elif k == 17:
        v = -1515870811
    return v as i32

@gpu(entry)
def int_i32(n: i64, a: &Buffer[i32, (512,), device_global], b: &Buffer[i32, (512,), device_global], out: &mut Buffer[i32, (11776,), device_global], cmp: &mut Buffer[i32, (512,), device_global]) -> None:
    let i: i64 = gpu_block_id(0) * gpu_block_dim(0) + gpu_thread_id(0)
    if i < n:
        let x: i32 = buffer_get(a, i)
        let y: i32 = buffer_get(b, i)
        buffer_set(out, i, x + y)
        buffer_set(out, 512 + i, x - y)
        buffer_set(out, 1024 + i, x * y)
        buffer_set(out, 1536 + i, x & y)
        buffer_set(out, 2048 + i, x | y)
        buffer_set(out, 2560 + i, x ^ y)
        buffer_set(out, 3072 + i, x << y)
        buffer_set(out, 3584 + i, x >> y)
        buffer_set(out, 4096 + i, x << (y & 31))
        buffer_set(out, 4608 + i, x >> (y & 31))
        buffer_set(out, 5120 + i, x << 35)
        buffer_set(out, 5632 + i, x >> 35)
        buffer_set(out, 6144 + i, x / 7)
        buffer_set(out, 6656 + i, x % 7)
        buffer_set(out, 7168 + i, x // 7)
        buffer_set(out, 7680 + i, x / 8)
        buffer_set(out, 8192 + i, x % 8)
        buffer_set(out, 8704 + i, x // 8)
        buffer_set(out, 9216 + i, x / -3)
        buffer_set(out, 9728 + i, x % -3)
        buffer_set(out, 10240 + i, x // -3)
        buffer_set(out, 10752 + i, x / -2147483648)
        buffer_set(out, 11264 + i, ~x)
        buffer_set(cmp, i, compare_bits_dev_i32(x, y))

@gpu
def compare_bits_dev_i32(x: i32, y: i32) -> i32:
    let mut c: i32 = 0
    if x < y:
        c = c + 1
    if x <= y:
        c = c + 2
    if x == y:
        c = c + 4
    if x != y:
        c = c + 8
    if x > y:
        c = c + 16
    if x >= y:
        c = c + 32
    return c

def compare_bits_host_i32(x: i32, y: i32) -> i32:
    let mut c: i32 = 0
    if x < y:
        c = c + 1
    if x <= y:
        c = c + 2
    if x == y:
        c = c + 4
    if x != y:
        c = c + 8
    if x > y:
        c = c + 16
    if x >= y:
        c = c + 32
