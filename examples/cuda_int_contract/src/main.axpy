@gpu(entry)
def sat_f32(n: i64, x: &Buffer[f32, (64,), device_global], out: &mut Buffer[i64, (512,), device_global]) -> None:
    let i: i64 = gpu_block_id(0) * gpu_block_dim(0) + gpu_thread_id(0)
    if i < n:
        let v: f32 = buffer_get(x, i)
        buffer_set(out, i, (v as i8) as i64)
        buffer_set(out, 64 + i, (v as i16) as i64)
        buffer_set(out, 128 + i, (v as i32) as i64)
        buffer_set(out, 192 + i, (v as i64) as i64)
        buffer_set(out, 256 + i, (v as u8) as i64)
        buffer_set(out, 320 + i, (v as u16) as i64)
        buffer_set(out, 384 + i, (v as u32) as i64)
        buffer_set(out, 448 + i, (v as u64) as i64)

def ref_sat_f32(k: i64, v: f32) -> i64:
    if k == 0:
        return (v as i8) as i64
    if k == 1:
        return (v as i16) as i64
    if k == 2:
        return (v as i32) as i64
    if k == 3:
        return (v as i64) as i64
    if k == 4:
        return (v as u8) as i64
    if k == 5:
        return (v as u16) as i64
    if k == 6:
        return (v as u32) as i64
    if k == 7:
        return (v as u64) as i64
    return 0

@gpu(entry)
def sat_f64(n: i64, x: &Buffer[f64, (64,), device_global], out: &mut Buffer[i64, (512,), device_global]) -> None:
    let i: i64 = gpu_block_id(0) * gpu_block_dim(0) + gpu_thread_id(0)
    if i < n:
        let v: f64 = buffer_get(x, i)
        buffer_set(out, i, (v as i8) as i64)
        buffer_set(out, 64 + i, (v as i16) as i64)
        buffer_set(out, 128 + i, (v as i32) as i64)
        buffer_set(out, 192 + i, (v as i64) as i64)
        buffer_set(out, 256 + i, (v as u8) as i64)
        buffer_set(out, 320 + i, (v as u16) as i64)
        buffer_set(out, 384 + i, (v as u32) as i64)
        buffer_set(out, 448 + i, (v as u64) as i64)

def ref_sat_f64(k: i64, v: f64) -> i64:
    if k == 0:
        return (v as i8) as i64
    if k == 1:
        return (v as i16) as i64
    if k == 2:
        return (v as i32) as i64
    if k == 3:
        return (v as i64) as i64
    if k == 4:
        return (v as u8) as i64
    if k == 5:
        return (v as u16) as i64
    if k == 6:
        return (v as u32) as i64
    if k == 7:
        return (v as u64) as i64
    return 0

# float -> int by explicit bounds (destination `k` as in `sat_f32`), the
# result as its i64 bit pattern: NaN -> 0, at or below MIN -> MIN, at or
# above MAX + 1 -> MAX, else the truncated value, which is in range.
def sat_oracle(k: i64, v: f64) -> i64:
    let mut bits: i64 = 0
    let signed: bool = k < 4
    if k == 0 or k == 4:
        bits = 8
    elif k == 1 or k == 5:
        bits = 16
    elif k == 2 or k == 6:
        bits = 32
    else:
        bits = 64
    if v != v:
        return 0
    let t: f64 = math_trunc(v)
    if signed:
        let lo: f64 = 0.0 - math_pow(2.0, (bits - 1) as f64)
        let hi: f64 = math_pow(2.0, (bits - 1) as f64)
        if t <= lo:
            if bits == 64:
                return -9223372036854775807 - 1
            return (0 - (1 << (bits - 1)))
        if t >= hi:
            if bits == 64:
                return 9223372036854775807
            return (1 << (bits - 1)) - 1
        return t as i64
    let hi: f64 = math_pow(2.0, bits as f64)
    if t <= 0.0:
        return 0
    if t >= hi:
        if bits == 64:
            return -1
        return (1 << bits) - 1
    if t >= 9223372036854775808.0:
        return (t - 9223372036854775808.0) as i64 + (-9223372036854775807 - 1)
    return t as i64

def check_sat_f32() -> i64:
    let mut hx: Buffer[f32, (64,)] = buffer_alloc([64])
    for i: i64 in range(N_FLOAT):
        buffer_set(hx, i, val_float(i) as f32)
    let dx: Buffer[f32, (64,), device_global] = buffer_to_device(hx)
    let mut dout: Buffer[i64, (512,), device_global] = buffer_to_device(fill_i64())
    gpu_launch(sat_f32, 1, 64, N_FLOAT, &dx, &mut dout)
    let got: Buffer[i64, (512,)] = buffer_to_host(dout)
    let mut bad: i64 = 0
    for i: i64 in range(N_FLOAT):
        let v: f32 = val_float(i) as f32
        for k: i64 in range(8):
            let g: i64 = buffer_get(got, k * 64 + i)
            let r: i64 = ref_sat_f32(k, v)
            if g != r:
                bad = bad + report("sat f32", k, i, g, r)
            if r != sat_oracle(k, v as f64):
                bad = bad + report("sat f32 oracle", k, i, r, sat_oracle(k, v as f64))
    return bad

def check_sat_f64() -> i64:
    let mut hx: Buffer[f64, (64,)] = buffer_alloc([64])
    for i: i64 in range(N_FLOAT):
        buffer_set(hx, i, val_float(i))
    let dx: Buffer[f64, (64,), device_global] = buffer_to_device(hx)
    let mut dout: Buffer[i64, (512,), device_global] = buffer_to_device(fill_i64())
    gpu_launch(sat_f64, 1, 64, N_FLOAT, &dx, &mut dout)
    let got: Buffer[i64, (512,)] = buffer_to_host(dout)
    let mut bad: i64 = 0
    for i: i64 in range(N_FLOAT):
        let v: f64 = val_float(i)
        for k: i64 in range(8):
            let g: i64 = buffer_get(got, k * 64 + i)
            let r: i64 = ref_sat_f64(k, v)
            if g != r:
                bad = bad + report("sat f64", k, i, g, r)
            if r != sat_oracle(k, v as f64):
                bad = bad + report("sat f64 oracle", k, i, r, sat_oracle(k, v as f64))
    return bad


# ---- no contraction: `x * y + z` is two roundings ----

@gpu(entry)
def mad_f32(x: &Buffer[f32, (4,), device_global], y: &Buffer[f32, (4,), device_global], z: &Buffer[f32, (4,), device_global], out: &mut Buffer[f32, (4,), device_global]) -> None:
    let i: i64 = gpu_thread_id(0)
    if i < 4:
        buffer_set(out, i, buffer_get(x, i) * buffer_get(y, i) + buffer_get(z, i))

@gpu(entry)
def mad_f64(x: &Buffer[f64, (4,), device_global], y: &Buffer[f64, (4,), device_global], z: &Buffer[f64, (4,), device_global], out: &mut Buffer[f64, (4,), device_global]) -> None:
    let i: i64 = gpu_thread_id(0)
    if i < 4:
        buffer_set(out, i, buffer_get(x, i) * buffer_get(y, i) + buffer_get(z, i))

# Lane 0: (1 + 2^-12)^2 - (1 + 2^-11): the exact product 1 + 2^-11 + 2^-24
# rounds to 1 + 2^-11 (a tie, to even), so the unfused result is +0.0 and a
# fused one 2^-24; lane 0 of `mad_f64` is the f64 analogue ((1 + 2^-27)^2 -
# (1 + 2^-26): +0.0 unfused, 2^-54 fused). Lanes 1-3 are ordinary values.
def check_contraction() -> i64:
    let mut x32: Buffer[f32, (4,)] = buffer_alloc([4])
    let mut z32: Buffer[f32, (4,)] = buffer_alloc([4])
    let mut x64: Buffer[f64, (4,)] = buffer_alloc([4])
    let mut z64: Buffer[f64, (4,)] = buffer_alloc([4])
    let a32: f32 = 1.000244140625_f32
    let c32: f32 = -1.00048828125_f32
    let a64: f64 = 1.000000007450580596923828125
    let c64: f64 = -1.0000000149011611938476562500
    for i: i64 in range(4):
        buffer_set(x32, i, a32 + (i as f32) * 0.375_f32)
        buffer_set(z32, i, c32 - (i as f32) * 1.25_f32)
        buffer_set(x64, i, a64 + (i as f64) * 0.375)
        buffer_set(z64, i, c64 - (i as f64) * 1.25)
    let mut y32: Buffer[f32, (4,)] = buffer_alloc([4])
    let mut y64: Buffer[f64, (4,)] = buffer_alloc([4])
    for i: i64 in range(4):
        buffer_set(y32, i, buffer_get(x32, i))
        buffer_set(y64, i, buffer_get(x64, i))
    let mut want32: Buffer[f32, (4,)] = buffer_alloc([4])
    let mut want64: Buffer[f64, (4,)] = buffer_alloc([4])
    for i: i64 in range(4):
        buffer_set(want32, i, buffer_get(x32, i) * buffer_get(y32, i) + buffer_get(z32, i))
        buffer_set(want64, i, buffer_get(x64, i) * buffer_get(y64, i) + buffer_get(z64, i))
    let dx32: Buffer[f32, (4,), device_global] = buffer_to_device(x32)
    let dy32: Buffer[f32, (4,), device_global] = buffer_to_device(y32)
    let dz32: Buffer[f32, (4,), device_global] = buffer_to_device(z32)
    let dx64: Buffer[f64, (4,), device_global] = buffer_to_device(x64)
    let dy64: Buffer[f64, (4,), device_global] = buffer_to_device(y64)
    let dz64: Buffer[f64, (4,), device_global] = buffer_to_device(z64)
    let o32: Buffer[f32, (4,)] = buffer_alloc([4])
    let o64: Buffer[f64, (4,)] = buffer_alloc([4])
    let mut do32: Buffer[f32, (4,), device_global] = buffer_to_device(o32)
    let mut do64: Buffer[f64, (4,), device_global] = buffer_to_device(o64)
    gpu_launch(mad_f32, 1, 32, &dx32, &dy32, &dz32, &mut do32)
    gpu_launch(mad_f64, 1, 32, &dx64, &dy64, &dz64, &mut do64)
    let g32: Buffer[f32, (4,)] = buffer_to_host(do32)
    let g64: Buffer[f64, (4,)] = buffer_to_host(do64)
    let mut bad: i64 = 0
    for i: i64 in range(4):
        let g: u32 = buffer_get(g32, i).to_bits()
        let w: u32 = buffer_get(want32, i).to_bits()
        if g != w:
            bad = bad + report("mad f32", 0, i, g as i64, w as i64)
        let h: u64 = buffer_get(g64, i).to_bits()
        let v: u64 = buffer_get(want64, i).to_bits()
        if h != v:
            bad = bad + report("mad f64", 0, i, h as i64, v as i64)
    if buffer_get(want32, 0).to_bits() != 0_u32 or buffer_get(want64, 0).to_bits() != 0_u64:
        bad = bad + report("unfused reference", 0, 0, buffer_get(want32, 0).to_bits() as i64, 0)
    return bad

def main() -> i32:
    let ints: i64 = check_i8() + check_i16() + check_i32() + check_i64() + check_u8() + check_u16() + check_u32() + check_u64()
    println!("integers: {ints} mismatches")
    let sat: i64 = check_sat_f32() + check_sat_f64()
    println!("conversions: {sat} mismatches")
    let mad: i64 = check_contraction()
    println!("contraction: {mad} mismatches")
    if ints + sat + mad != 0:
        return 1
    println!("int contract: i8-i64 and u8-u64 arithmetic, masked shifts, literal-divisor division, saturating conversions and uncontracted f32/f64 match the strict host")
    return 0
