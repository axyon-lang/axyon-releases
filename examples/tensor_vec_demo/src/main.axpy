# Tensors as `Vec` elements (issue #3199).
#
# A `Vec[Tensor[..]]` owns a variable number of tensors, e.g. the parameters
# of a model with N layers. `push` moves a tensor in, `&v[i]` borrows a
# snapshot of an element, `v[i][r, c]` reads and writes the element in
# place, `v[i] = t` replaces an element (freeing the old storage), and
# dropping the `Vec` frees every element.
import std.tensor as T

struct ParamSet:
    mats: Vec[Tensor[f32, (?, ?)]]

impl ParamSet:
    def forward(self: ref[Self], i: i64, x: &Tensor[f32, (?, ?)]) -> Tensor[f32, (?, ?)]:
        return T.matmul(self.mats[i], *x)

def build(layers: i64, width: i64) -> ParamSet:
    let mut mats: Vec[Tensor[f32, (?, ?)]] = Vec.with_capacity(layers)
    for k: i64 in range(layers):
        mats.push(T.full([width, width], (k + 1) as f32))
    return ParamSet { mats: mats }

def main() -> i32:
    let mut ps: ParamSet = build(3, 2)
    # In-place element write into layer 0's weight.
    ps.mats[0][0, 1] = 0.0
    # Replace layer 2's weight; its old block is freed.
    ps.mats[2] = T.zeros([2, 2])
    let mut x: Tensor[f32, (?, ?)] = T.ones([2, 1])
    for i: i64 in range(ps.mats.len() as i64):
        x = ps.forward(i, &x)
        println!("after layer {}: [{}, {}]", i, x[0, 0], x[1, 0])
    let popped: Tensor[f32, (?, ?)] = ps.mats.pop()
    println!("layers left: {}, popped[1, 1] = {}", ps.mats.len(), popped[1, 1])
    return 0
