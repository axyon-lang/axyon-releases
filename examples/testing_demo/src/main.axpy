# ============================================================================
# Combined Options - Multiple decorator arguments
# ============================================================================

@test(device="cpu", timeout=2000)
def test_combined_options() -> i32:
    """Test with both device filter and timeout."""
    let mut sum: i64 = 0
    for i in range(1000):
        sum += i
    assert!(sum == 499500, "sum of 0..1000 should equal 499500")
    return 0

# ============================================================================
# Address-preserving borrows (issue #573)
# ============================================================================
# A borrow lowers to the borrowed place's address, so a write through the
# reference must be visible in the original storage. These run through the full
# MLIR/LLVM toolchain in PR CI (test-axyon-projects).

struct BorrowPoint:
    x: i32
    y: i32

def borrow_set(r: ref_mut[i32], v: i32) -> unit:
    *r = v

def borrow_bump(r: ref_mut[i32]) -> unit:
    let cur: i32 = *r
    borrow_set(ref_mut(*r), cur + 1)

def borrow_read(r: ref[i32]) -> i32:
    let v: i32 = *r
    return v

@test
def test_field_borrow_of_local_mutates_the_local() -> i32:
    """`ref_mut(p.y)` aliases the field inside `p`'s storage."""
    let mut p: BorrowPoint = BorrowPoint { x: 1, y: 2 }
    borrow_set(ref_mut(p.y), 40)
    assert!(p.y == 40, "write through a field borrow must reach p.y")
    assert!(p.x == 1, "sibling field must be untouched")
    return 0

@test
def test_deref_borrow_of_parameter_mutates_the_original() -> i32:
    """`ref_mut(*r)` re-borrows the pointer `r` holds, not a copy."""
    let mut n: i32 = 7
    borrow_bump(ref_mut(n))
    assert!(n == 8, "bump through a re-borrowed parameter must reach n")
    return 0

@test
def test_shared_borrow_observes_the_local() -> i32:
    """A shared field borrow reads the field's current storage, not a stale copy."""
    let mut p: BorrowPoint = BorrowPoint { x: 3, y: 4 }
    let thirty: i32 = 30
    p.x = thirty
    assert!(borrow_read(ref(p.x)) == 30, "shared field borrow sees the write")
    return 0

@test
def test_borrows_retained_across_iterations_stay_distinct() -> i32:
    """One reference retained per loop iteration keeps its own value.

    Each iteration borrows a distinct Vec element (a place), so the three
    retained references must read 0, 10, 20. A borrow of a *temporary* inside
    the loop (`refs.push(ref(i * 10))`) is rejected at compile time: it would
    reuse one spill slot and every reference would read the last value.
    """
    let mut vals: Vec[i32] = Vec.new()
    for i: i32 in range(3):
        vals.push(i * 10)
    let mut refs: Vec[ref[i32]] = Vec.new()
    for k: i64 in range(3):
        refs.push(ref(vals[k]))
    let r0: ref[i32] = refs[0]
    let r1: ref[i32] = refs[1]
    let r2: ref[i32] = refs[2]
    assert!(borrow_read(r0) == 0, "first retained reference keeps iteration 0")
    assert!(borrow_read(r1) == 10, "second retained reference keeps iteration 1")
    assert!(borrow_read(r2) == 20, "third retained reference keeps iteration 2")
    return 0

# A reference to a loop variable kept in an outer collection
# (`refs.push(ref(i))`) is rejected with AX0524 (#1077): the variable is
# re-bound every iteration, so the reference would outlive its own iteration.
# The earlier tests that retained such references (#573) were removed with that
# rule; borrows of distinct Vec elements (above) are still retained.

@test
def test_vec_element_borrow_mutates_the_element() -> i32:
    """`ref_mut(v[i])` points into the Vec's heap buffer, not a copy."""
    let mut v: Vec[i32] = Vec.new()
    v.push(1)
    v.push(2)
    borrow_set(ref_mut(v[1]), 9)
    assert!(v[1] == 9, "write through a Vec element borrow must reach v[1]")
    assert!(v[0] == 1, "sibling element must be untouched")
    return 0

@test
def test_array_element_borrow_mutates_the_element() -> i32:
    """`ref_mut(a[i])` points into the array's storage."""
    let mut a: Array[i32; 3] = [1, 2, 3]
    let i: i64 = 2
    borrow_set(ref_mut(a[i]), 30)
    assert!(a[2] == 30, "write through an array element borrow must reach a[2]")
    return 0

# ============================================================================
# Main Entry Point
# ============================================================================

def main() -> i32:
    """Main function - run 'axyon test' to execute tests."""
    println!("Testing Demo")
    println!("============")
    println!("")
    println!("Run tests with: axyon test")
    println!("")
    println!("Options:")
    println!("  --verbose    Show detailed output")
    println!("  --filter X   Run tests matching X")
    println!("  --device X   Run only tests for device X")
    println!("  --fail-fast  Stop on first failure")
    println!("")
    println!("Decorators:")
    println!("  @test                    Basic test")
    println!("  @test(timeout=1000)      1s timeout")
    println!("  @test(device=\"cpu\")      CPU-only")
    println!("  @test(skip=True)         Skip test")
    println!("  @test(should_panic=True) Expect panic")
    return 0
