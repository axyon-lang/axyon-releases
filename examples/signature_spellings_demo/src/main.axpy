# Issue #903: Rust-style signature spellings accepted as aliases.
struct Ledger:
    total: i64

struct Stack[T]:
    n: i64

# `impl[T] Stack[T]:` is an alias of `impl Stack[T]:`.
impl[T] Stack[T]:
    def size(self) -> i64:
        return self.n

impl Ledger:
    # `self: &mut Self` is an alias of `mut self`.
    def deposit(self: &mut Self, amount: i64) -> None:
        self.total = self.total + amount

# `mut n` makes the parameter a mutable local binding.
def bump(mut n: i64, k: i64) -> i64:
    n = n + k
    return n

def main() -> i32:
    let mut l: Ledger = Ledger { total: 1 }
    l.deposit(5)
    assert!(l.total == 6, "deposit mutates the caller's value")

    assert!(bump(1, 2) == 3, "mut parameter can be reassigned")

    let s: Stack[i64] = Stack { n: 3 }
    let size: i64 = s.size()
    assert!(size == 3, "impl[T] methods work")
    println!("total={l.total} size={size}")
    return 0
