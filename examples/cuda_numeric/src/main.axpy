# ---- Section 1: scalar arithmetic, one rounding per operation ----

@gpu(entry)
def arith_f16(n: i64, a: &Buffer[f16, (512,), device_global], b: &Buffer[f16, (512,), device_global], out: &mut Buffer[f16, (4608,), device_global], cmp: &mut Buffer[i32, (512,), device_global]) -> None:
    let i: i64 = gpu_block_id(0) * gpu_block_dim(0) + gpu_thread_id(0)
    if i < n:
        let x: f16 = buffer_get(a, i)
        let y: f16 = buffer_get(b, i)
        buffer_set(out, i, x + y)
        buffer_set(out, 512 + i, x - y)
        buffer_set(out, 1024 + i, x * y)
        buffer_set(out, 1536 + i, x / y)
        buffer_set(out, 2048 + i, x * y + x)
        buffer_set(out, 2560 + i, math_sqrt(x))
        buffer_set(out, 3072 + i, -x)
        buffer_set(out, 3584 + i, math_fmin(x, y))
        buffer_set(out, 4096 + i, math_fmax(x, y))
        let mut c: i32 = 0
        if x < y:
            c = c + 1
        if x <= y:
            c = c + 2
        if x == y:
            c = c + 4
        if x != y:
            c = c + 8
        if x > y:
            c = c + 16
        if x >= y:
            c = c + 32
        buffer_set(cmp, i, c)

