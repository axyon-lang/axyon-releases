# Every op over every pair of the `f16` table plus the `f16` fixture lanes.
def check_arith_f16() -> i64:
    let mut a: Buffer[f16, (512,)] = buffer_alloc([512])
    let mut b: Buffer[f16, (512,)] = buffer_alloc([512])
    let mut want: Buffer[f16, (4608,)] = buffer_alloc([4608])
    let mut wcmp: Buffer[i32, (512,)] = buffer_alloc([512])
    let mut sentinel: Buffer[f16, (4608,)] = buffer_alloc([4608])
    let mut csentinel: Buffer[i32, (512,)] = buffer_alloc([512])
    let mut n: i64 = 0
    for p: i64 in range(20):
        for q: i64 in range(20):
            let x: f16 = f64.from_bits(fx_table_f16(p)) as f16
            let y: f16 = f64.from_bits(fx_table_f16(q)) as f16
            buffer_set(a, n, x)
            buffer_set(b, n, y)
            want = ref_arith_f16(x, y, n, want)
            buffer_set(wcmp, n, ref_cmp_f16(x, y))
            n = n + 1
    let first_fix: i64 = n
    for f: i64 in range(N_ARITH_FIX):
        if fx_arith_fmt(f) == 0:
            let x: f16 = f64.from_bits(fx_arith_a(f)) as f16
            let y: f16 = f64.from_bits(fx_arith_b(f)) as f16
            buffer_set(a, n, x)
            buffer_set(b, n, y)
            want = ref_arith_f16(x, y, n, want)
            buffer_set(wcmp, n, ref_cmp_f16(x, y))
            n = n + 1
    let da: Buffer[f16, (512,), device_global] = buffer_to_device(a)
    let db: Buffer[f16, (512,), device_global] = buffer_to_device(b)
    let mut dout: Buffer[f16, (4608,), device_global] = buffer_to_device(sentinel)
    let mut dcmp: Buffer[i32, (512,), device_global] = buffer_to_device(csentinel)
    gpu_launch(arith_f16, blocks_for(n), BLOCK, n, &da, &db, &mut dout, &mut dcmp)
    let got: Buffer[f16, (4608,)] = buffer_to_host(dout)
    let gcmp: Buffer[i32, (512,)] = buffer_to_host(dcmp)
    # The operands, for the `math_fmin`/`math_fmax` zero-tie rule (`a` and
    # `b` moved to the device).
    let xa: Buffer[f16, (512,)] = buffer_to_host(da)
    let xb: Buffer[f16, (512,)] = buffer_to_host(db)
    let mut bad: i64 = 0
    for op: i64 in range(9):
        for i: i64 in range(n):
            let g: f64 = buffer_get(got, op * 512 + i) as f64
            let w: f64 = buffer_get(want, op * 512 + i) as f64
            if not same_op(op, buffer_get(xa, i) as f64, buffer_get(xb, i) as f64, g, w):
                bad = bad + report("f16", op, i, g, w)
    for i: i64 in range(n):
        if buffer_get(gcmp, i) != buffer_get(wcmp, i):
            bad = bad + report("f16 compare", 0, i, 0.0, 1.0)
    # The independent fixtures: the GPU and the host must both give the
    # exact-rational result.
    let mut k: i64 = first_fix
    for f: i64 in range(N_ARITH_FIX):
        if fx_arith_fmt(f) == 0:
            let e: f64 = f64.from_bits(fx_arith_expect(f))
            let g: f64 = buffer_get(got, fx_arith_op(f) * 512 + k) as f64
            let w: f64 = buffer_get(want, fx_arith_op(f) * 512 + k) as f64
            if not same_op(fx_arith_op(f), buffer_get(xa, k) as f64, buffer_get(xb, k) as f64, g, e):
                bad = bad + report("f16 fixture (gpu)", fx_arith_op(f), f, g, e)
            if not same_op(fx_arith_op(f), buffer_get(xa, k) as f64, buffer_get(xb, k) as f64, w, e):
                bad = bad + report("f16 fixture (host)", fx_arith_op(f), f, w, e)
            k = k + 1
    return bad

# Every op over every pair of the `bf16` table plus the `bf16` fixture lanes.
def check_arith_bf16() -> i64:
    let mut a: Buffer[bf16, (512,)] = buffer_alloc([512])
