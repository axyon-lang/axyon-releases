def check_cvt_f16() -> i64:
    let mut x: Buffer[f16, (128,)] = buffer_alloc([128])
    let mut want_f: Buffer[f64, (512,)] = buffer_alloc([512])
    let mut want_i: Buffer[i64, (1024,)] = buffer_alloc([1024])
    let mut n: i64 = 0
    for p: i64 in range(20):
        let v: f16 = f64.from_bits(fx_table_f16(p)) as f16
        buffer_set(x, n, v)
        want_f = ref_cvtf_f16(v, n, want_f)
        want_i = ref_cvti_f16(v, n, want_i)
        n = n + 1
    let first_fix: i64 = n
    for f: i64 in range(N_CVT_FIX):
        if fx_cvt_src(f) == 0:
            let v: f16 = f64.from_bits(fx_cvt_in(f)) as f16
            buffer_set(x, n, v)
            want_f = ref_cvtf_f16(v, n, want_f)
            want_i = ref_cvti_f16(v, n, want_i)
            n = n + 1
    let dx: Buffer[f16, (128,), device_global] = buffer_to_device(x)
    let mut dfo: Buffer[f64, (512,), device_global] = buffer_to_device(fill_f64(512))
    let mut dio: Buffer[i64, (1024,), device_global] = buffer_to_device(fill_i64(1024))
    gpu_launch(cvt_f16, blocks_for(n), BLOCK, n, &dx, &mut dfo, &mut dio)
    let got_f: Buffer[f64, (512,)] = buffer_to_host(dfo)
    let got_i: Buffer[i64, (1024,)] = buffer_to_host(dio)
    return compare_cvt(0, n, first_fix, got_f, got_i, want_f, want_i)

def check_cvt_bf16() -> i64:
    let mut x: Buffer[bf16, (128,)] = buffer_alloc([128])
    let mut want_f: Buffer[f64, (512,)] = buffer_alloc([512])
    let mut want_i: Buffer[i64, (1024,)] = buffer_alloc([1024])
