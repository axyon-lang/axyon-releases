    # `b` moved to the device).
    let xa: Buffer[bf16, (512,)] = buffer_to_host(da)
    let xb: Buffer[bf16, (512,)] = buffer_to_host(db)
    let mut bad: i64 = 0
    for op: i64 in range(9):
        for i: i64 in range(n):
            let g: f64 = buffer_get(got, op * 512 + i) as f64
            let w: f64 = buffer_get(want, op * 512 + i) as f64
            if not same_op(op, buffer_get(xa, i) as f64, buffer_get(xb, i) as f64, g, w):
                bad = bad + report("bf16", op, i, g, w)
    for i: i64 in range(n):
        if buffer_get(gcmp, i) != buffer_get(wcmp, i):
            bad = bad + report("bf16 compare", 0, i, 0.0, 1.0)
    # The independent fixtures: the GPU and the host must both give the
    # exact-rational result.
    let mut k: i64 = first_fix
    for f: i64 in range(N_ARITH_FIX):
        if fx_arith_fmt(f) == 1:
            let e: f64 = f64.from_bits(fx_arith_expect(f))
            let g: f64 = buffer_get(got, fx_arith_op(f) * 512 + k) as f64
            let w: f64 = buffer_get(want, fx_arith_op(f) * 512 + k) as f64
            if not same_op(fx_arith_op(f), buffer_get(xa, k) as f64, buffer_get(xb, k) as f64, g, e):
                bad = bad + report("bf16 fixture (gpu)", fx_arith_op(f), f, g, e)
            if not same_op(fx_arith_op(f), buffer_get(xa, k) as f64, buffer_get(xb, k) as f64, w, e):
                bad = bad + report("bf16 fixture (host)", fx_arith_op(f), f, w, e)
            k = k + 1
    return bad

# Every op over every pair of the `f32` table plus the `f32` fixture lanes.
def check_arith_f32() -> i64:
    let mut a: Buffer[f32, (512,)] = buffer_alloc([512])
    let mut b: Buffer[f32, (512,)] = buffer_alloc([512])
    let mut want: Buffer[f32, (4608,)] = buffer_alloc([4608])
    let mut wcmp: Buffer[i32, (512,)] = buffer_alloc([512])
    let mut sentinel: Buffer[f32, (4608,)] = buffer_alloc([4608])
    let mut csentinel: Buffer[i32, (512,)] = buffer_alloc([512])
    let mut n: i64 = 0
    for p: i64 in range(20):
        for q: i64 in range(20):
            let x: f32 = f64.from_bits(fx_table_f32(p)) as f32
            let y: f32 = f64.from_bits(fx_table_f32(q)) as f32
            buffer_set(a, n, x)
            buffer_set(b, n, y)
            want = ref_arith_f32(x, y, n, want)
            buffer_set(wcmp, n, ref_cmp_f32(x, y))
            n = n + 1
    let first_fix: i64 = n
    for f: i64 in range(N_ARITH_FIX):
        if fx_arith_fmt(f) == 2:
            let x: f32 = f64.from_bits(fx_arith_a(f)) as f32
            let y: f32 = f64.from_bits(fx_arith_b(f)) as f32
            buffer_set(a, n, x)
            buffer_set(b, n, y)
            want = ref_arith_f32(x, y, n, want)
            buffer_set(wcmp, n, ref_cmp_f32(x, y))
            n = n + 1
    let da: Buffer[f32, (512,), device_global] = buffer_to_device(a)
    let db: Buffer[f32, (512,), device_global] = buffer_to_device(b)
    let mut dout: Buffer[f32, (4608,), device_global] = buffer_to_device(sentinel)
    let mut dcmp: Buffer[i32, (512,), device_global] = buffer_to_device(csentinel)
    gpu_launch(arith_f32, blocks_for(n), BLOCK, n, &da, &db, &mut dout, &mut dcmp)
    let got: Buffer[f32, (4608,)] = buffer_to_host(dout)
    let gcmp: Buffer[i32, (512,)] = buffer_to_host(dcmp)
    # The operands, for the `math_fmin`/`math_fmax` zero-tie rule (`a` and
    # `b` moved to the device).
    let xa: Buffer[f32, (512,)] = buffer_to_host(da)
    let xb: Buffer[f32, (512,)] = buffer_to_host(db)
    let mut bad: i64 = 0
    for op: i64 in range(9):
        for i: i64 in range(n):
            let g: f64 = buffer_get(got, op * 512 + i) as f64
            let w: f64 = buffer_get(want, op * 512 + i) as f64
            if not same_op(op, buffer_get(xa, i) as f64, buffer_get(xb, i) as f64, g, w):
                bad = bad + report("f32", op, i, g, w)
    for i: i64 in range(n):
        if buffer_get(gcmp, i) != buffer_get(wcmp, i):
            bad = bad + report("f32 compare", 0, i, 0.0, 1.0)
    # The independent fixtures: the GPU and the host must both give the
    # exact-rational result.
    let mut k: i64 = first_fix
    for f: i64 in range(N_ARITH_FIX):
        if fx_arith_fmt(f) == 2:
            let e: f64 = f64.from_bits(fx_arith_expect(f))
            let g: f64 = buffer_get(got, fx_arith_op(f) * 512 + k) as f64
            let w: f64 = buffer_get(want, fx_arith_op(f) * 512 + k) as f64
            if not same_op(fx_arith_op(f), buffer_get(xa, k) as f64, buffer_get(xb, k) as f64, g, e):
                bad = bad + report("f32 fixture (gpu)", fx_arith_op(f), f, g, e)
            if not same_op(fx_arith_op(f), buffer_get(xa, k) as f64, buffer_get(xb, k) as f64, w, e):
                bad = bad + report("f32 fixture (host)", fx_arith_op(f), f, w, e)
            k = k + 1
    return bad

# Every op over every pair of the `f64` table plus the `f64` fixture lanes.
def check_arith_f64() -> i64:
    let mut a: Buffer[f64, (512,)] = buffer_alloc([512])
    let mut b: Buffer[f64, (512,)] = buffer_alloc([512])
    let mut want: Buffer[f64, (4608,)] = buffer_alloc([4608])
    let mut wcmp: Buffer[i32, (512,)] = buffer_alloc([512])
    let mut sentinel: Buffer[f64, (4608,)] = buffer_alloc([4608])
    let mut csentinel: Buffer[i32, (512,)] = buffer_alloc([512])
    let mut n: i64 = 0
    for p: i64 in range(20):
        for q: i64 in range(20):
            let x: f64 = f64.from_bits(fx_table_f64(p)) as f64
            let y: f64 = f64.from_bits(fx_table_f64(q)) as f64
            buffer_set(a, n, x)
            buffer_set(b, n, y)
            want = ref_arith_f64(x, y, n, want)
            buffer_set(wcmp, n, ref_cmp_f64(x, y))
            n = n + 1
    let first_fix: i64 = n
    for f: i64 in range(N_ARITH_FIX):
        if fx_arith_fmt(f) == 3:
            let x: f64 = f64.from_bits(fx_arith_a(f)) as f64
            let y: f64 = f64.from_bits(fx_arith_b(f)) as f64
            buffer_set(a, n, x)
            buffer_set(b, n, y)
            want = ref_arith_f64(x, y, n, want)
            buffer_set(wcmp, n, ref_cmp_f64(x, y))
            n = n + 1
    let da: Buffer[f64, (512,), device_global] = buffer_to_device(a)
    let db: Buffer[f64, (512,), device_global] = buffer_to_device(b)
    let mut dout: Buffer[f64, (4608,), device_global] = buffer_to_device(sentinel)
    let mut dcmp: Buffer[i32, (512,), device_global] = buffer_to_device(csentinel)
    gpu_launch(arith_f64, blocks_for(n), BLOCK, n, &da, &db, &mut dout, &mut dcmp)
    let got: Buffer[f64, (4608,)] = buffer_to_host(dout)
    let gcmp: Buffer[i32, (512,)] = buffer_to_host(dcmp)
    # The operands, for the `math_fmin`/`math_fmax` zero-tie rule (`a` and
    # `b` moved to the device).
    let xa: Buffer[f64, (512,)] = buffer_to_host(da)
    let xb: Buffer[f64, (512,)] = buffer_to_host(db)
    let mut bad: i64 = 0
    for op: i64 in range(9):
        for i: i64 in range(n):
            let g: f64 = buffer_get(got, op * 512 + i) as f64
            let w: f64 = buffer_get(want, op * 512 + i) as f64
            if not same_op(op, buffer_get(xa, i) as f64, buffer_get(xb, i) as f64, g, w):
                bad = bad + report("f64", op, i, g, w)
    for i: i64 in range(n):
        if buffer_get(gcmp, i) != buffer_get(wcmp, i):
            bad = bad + report("f64 compare", 0, i, 0.0, 1.0)
    # The independent fixtures: the GPU and the host must both give the
    # exact-rational result.
    let mut k: i64 = first_fix
    for f: i64 in range(N_ARITH_FIX):
        if fx_arith_fmt(f) == 3:
            let e: f64 = f64.from_bits(fx_arith_expect(f))
            let g: f64 = buffer_get(got, fx_arith_op(f) * 512 + k) as f64
            let w: f64 = buffer_get(want, fx_arith_op(f) * 512 + k) as f64
            if not same_op(fx_arith_op(f), buffer_get(xa, k) as f64, buffer_get(xb, k) as f64, g, e):
                bad = bad + report("f64 fixture (gpu)", fx_arith_op(f), f, g, e)
            if not same_op(fx_arith_op(f), buffer_get(xa, k) as f64, buffer_get(xb, k) as f64, w, e):
                bad = bad + report("f64 fixture (host)", fx_arith_op(f), f, w, e)
            k = k + 1
    return bad

# ---- Section 2: conversions (`as`) ----

@gpu(entry)
def cvt_f16(n: i64, x: &Buffer[f16, (128,), device_global], fo: &mut Buffer[f64, (512,), device_global], io: &mut Buffer[i64, (1024,), device_global]) -> None:
    let i: i64 = gpu_block_id(0) * gpu_block_dim(0) + gpu_thread_id(0)
    if i < n:
        let v: f16 = buffer_get(x, i)
        buffer_set(fo, 0 + i, (v as f16) as f64)
        buffer_set(fo, 128 + i, (v as bf16) as f64)
        buffer_set(fo, 256 + i, (v as f32) as f64)
        buffer_set(fo, 384 + i, (v as f64) as f64)
        buffer_set(io, 0 + i, (v as i8) as i64)
        buffer_set(io, 128 + i, (v as u8) as i64)
        buffer_set(io, 256 + i, (v as i16) as i64)
        buffer_set(io, 384 + i, (v as u16) as i64)
        buffer_set(io, 512 + i, (v as i32) as i64)
        buffer_set(io, 640 + i, (v as u32) as i64)
        buffer_set(io, 768 + i, (v as i64) as i64)
        buffer_set(io, 896 + i, (v as u64) as i64)

