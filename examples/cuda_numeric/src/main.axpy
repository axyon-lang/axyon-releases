# Mixed-precision arithmetic, conversions and accumulation on an NVIDIA GPU
# (issue #2111)
#
# Every kernel runs on the device and every result is compared bit for bit
# (any NaN matches any NaN) with the strict host build of the same
# expression, and, for the boundary cases, with an independent bit-pattern
# fixture computed by exact rational arithmetic (`fixtures.py`):
#
# 1. Scalar arithmetic in f16, bf16, f32 and f64: `+ - * /`, `a * b + a`
#    (two roundings, never fused), `math_sqrt`, negation, `math_fmin`/`fmax`
#    (IEEE minimumNumber/maximumNumber) and the six comparisons, over every
#    pair of a 20-value table per format (zeros of both signs, the smallest
#    and largest subnormal, the smallest normal, 1 + ulp, the largest finite
#    value, infinities, NaN) plus rounding-boundary fixtures: overflow ties,
#    ties to even, gradual underflow (no flush to zero), cancellation,
#    division by zero, invalid operations and signed zeros. Each operation
#    is rounded once to its own type (numeric contract §7 rule 2).
# 2. Conversions (`as`) from f16, bf16, f32, f64, i64 and u64 to all four
#    float and eight integer types: float -> int truncates toward zero and
#    saturates (NaN -> 0), int -> int wraps, every conversion to a float
#    rounds once to nearest even (f64 -> bf16 and i64/u64 -> bf16 included,
#    where a route through f32 would round twice). Each result is widened
#    exactly (`as f64` / `as i64`) before it is stored.
# 3. Explicit mixed accumulation: f16 and bf16 inputs accumulated in an f32
#    accumulator (`acc = acc + (a as f32) * (b as f32)`, a dense matmul,
#    untiled and through the #2110 workgroup-memory tiles with barriers, and
#    row sums; a #2109 workgroup sum of `x as f32` in the strict tier, the
#    #2680 sequential order), against the same reduction
#    with a rounded f16 accumulator, which stalls at 2048 on a row of 4096
#    ones. Mixing is never implicit: `f16 + f32` is a type error (AX0556).
# 4. Constant/runtime agreement: compile-time folded f16/bf16/f32/f64
#    expressions equal the GPU's results for the same operands.
#
# Strict math only: no fast math, no `.ftz`, no `.approx`, no contraction,
# no TF32 (an NVIDIA device rejects relaxed host math at build time).

const BLOCK: i64 = 128

def blocks_for(n: i64) -> i64:
    return (n + BLOCK - 1) / BLOCK

# The same value: equal bit patterns, or both NaN (payloads are not part of
# the contract). The bits keep the sign of zero.
def same(x: f64, y: f64) -> bool:
    if x != x:
        return y != y
    return x.to_bits() == y.to_bits()

# `same`, except for the one variation the contract permits: `math_fmin`
# (op 7) and `math_fmax` (op 8) are C `fmin`/`fmax` (IEEE minNum/maxNum),
# which leave the sign of the result unspecified only when the operands
# `xa`, `xb` are a `+0`/`-0` tie (the NVIDIA `min`/`max` instructions order
# `-0 < +0`, x86 `minsd` returns an operand). Then both results must still
# be zeros. Same-sign zero operands, a zero and a nonzero operand, every
# other op, every NaN rule and every nonzero result stay exact. The
# `min`/`max` builtins, which do order the zeros (numeric contract §5.3a),
# are host-only today.
def same_op(op: i64, xa: f64, xb: f64, x: f64, y: f64) -> bool:
    if op >= 7 and xa == 0.0 and xb == 0.0 and xa.to_bits() != xb.to_bits():
        return x == 0.0 and y == 0.0
    return same(x, y)

# The comparison must reject what the contract does not permit: a
# zero-sign difference of `math_fmin`/`math_fmax` with same-sign zero
# operands or a zero and a nonzero operand, and any sign difference of
# another op. Returns the number of wrong verdicts.
def check_same_op() -> i64:
    let pz: f64 = 0.0
    let nz: f64 = -0.0
    let mut bad: i64 = 0
    # Permitted: a +0/-0 operand tie, in either order, returns either zero.
    if not same_op(7, pz, nz, pz, nz):
        bad = bad + report("same_op (+0/-0 tie)", 7, 0, pz, nz)
    if not same_op(8, nz, pz, nz, pz):
        bad = bad + report("same_op (-0/+0 tie)", 8, 1, nz, pz)
    # Even a tie must return a zero.
    if same_op(7, pz, nz, 1.0, pz):
        bad = bad + report("same_op (tie, nonzero result)", 7, 2, 1.0, pz)
    # Same-sign zero operands: the sign is determined.
    if same_op(7, nz, nz, pz, nz):
        bad = bad + report("same_op (-0/-0)", 7, 3, pz, nz)
    if same_op(8, pz, pz, nz, pz):
        bad = bad + report("same_op (+0/+0)", 8, 4, nz, pz)
    # A zero and a nonzero operand: `math_fmin(-0.0, 1.0)` is `-0.0`.
    if same_op(7, nz, 1.0, pz, nz):
        bad = bad + report("same_op (-0/1)", 7, 5, pz, nz)
    if same_op(8, pz, -1.0, nz, pz):
        bad = bad + report("same_op (+0/-1)", 8, 6, nz, pz)
    # Another op with a +0/-0 tie stays exact (`+0 - -0` is `+0`).
    if same_op(1, pz, nz, nz, pz):
        bad = bad + report("same_op (sub tie)", 1, 7, nz, pz)
    return bad

# Print the first mismatches of a check; returns 1 (one mismatch).
def report(what: str, op: i64, i: i64, got: f64, want: f64) -> i64:
    println!("{what} mismatch: op {op} lane {i}: got {got}, want {want}")
    return 1

# Output sentinels: lanes past `n` keep them.
def fill_f64(n: i64) -> Buffer[f64, (512,)]:
    let mut b: Buffer[f64, (512,)] = buffer_alloc([512])
    for i: i64 in range(n):
        buffer_set(b, i, -7.0)
    return b

def fill_i64(n: i64) -> Buffer[i64, (1024,)]:
    let mut b: Buffer[i64, (1024,)] = buffer_alloc([1024])
    for i: i64 in range(n):
        buffer_set(b, i, -7)
    return b


