        if fx_cvt_src(f) == 1:
            let v: bf16 = f64.from_bits(fx_cvt_in(f)) as bf16
            buffer_set(x, n, v)
            want_f = ref_cvtf_bf16(v, n, want_f)
            want_i = ref_cvti_bf16(v, n, want_i)
            n = n + 1
    let dx: Buffer[bf16, (128,), device_global] = buffer_to_device(x)
    let mut dfo: Buffer[f64, (512,), device_global] = buffer_to_device(fill_f64(512))
    let mut dio: Buffer[i64, (1024,), device_global] = buffer_to_device(fill_i64(1024))
    gpu_launch(cvt_bf16, blocks_for(n), BLOCK, n, &dx, &mut dfo, &mut dio)
    let got_f: Buffer[f64, (512,)] = buffer_to_host(dfo)
    let got_i: Buffer[i64, (1024,)] = buffer_to_host(dio)
    return compare_cvt(1, n, first_fix, got_f, got_i, want_f, want_i)

