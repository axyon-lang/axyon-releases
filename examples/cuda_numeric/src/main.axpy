# Compare one conversion run with the host and with the fixtures of source
# `src` (fixture lanes start at `first_fix`).
def compare_cvt(src: i64, n: i64, first_fix: i64, got_f: Buffer[f64, (512,)], got_i: Buffer[i64, (1024,)], want_f: Buffer[f64, (512,)], want_i: Buffer[i64, (1024,)]) -> i64:
    let mut bad: i64 = 0
    for d: i64 in range(4):
        for i: i64 in range(n):
            let g: f64 = buffer_get(got_f, d * 128 + i)
            let w: f64 = buffer_get(want_f, d * 128 + i)
            if not same(g, w):
                bad = bad + report("conversion", d, i, g, w)
    for d: i64 in range(8):
        for i: i64 in range(n):
            let g: i64 = buffer_get(got_i, d * 128 + i)
            let w: i64 = buffer_get(want_i, d * 128 + i)
            if g != w:
                bad = bad + report("conversion", d + 4, i, g as f64, w as f64)
    let mut k: i64 = first_fix
    for f: i64 in range(N_CVT_FIX):
        if fx_cvt_src(f) == src:
            let d: i64 = fx_cvt_dst(f)
            if d < 4:
                let e: f64 = f64.from_bits(fx_cvt_expect(f))
                let g: f64 = buffer_get(got_f, d * 128 + k)
                let w: f64 = buffer_get(want_f, d * 128 + k)
                if not same(g, e):
                    bad = bad + report("conversion fixture (gpu)", d, f, g, e)
                if not same(w, e):
                    bad = bad + report("conversion fixture (host)", d, f, w, e)
            else:
                let e: i64 = fx_cvt_expect(f) as i64
                let g: i64 = buffer_get(got_i, (d - 4) * 128 + k)
                let w: i64 = buffer_get(want_i, (d - 4) * 128 + k)
                if g != e:
                    bad = bad + report("conversion fixture (gpu)", d, f, g as f64, e as f64)
                if w != e:
                    bad = bad + report("conversion fixture (host)", d, f, w as f64, e as f64)
            k = k + 1
    return bad

# ---- Section 3: explicit mixed accumulation ----

# c = a x b for 64 x 64 matrices of f16, each product and sum in an f32
# accumulator (the inputs widen exactly), the result stored in f32 and
# rounded once to f16. One thread per element of c.
@gpu(entry)
def matmul_f16_acc_f32(a: &Buffer[f16, (4096,), device_global], b: &Buffer[f16, (4096,), device_global], c32: &mut Buffer[f32, (4096,), device_global], c16: &mut Buffer[f16, (4096,), device_global]) -> None:
    let t: i64 = gpu_block_id(0) * gpu_block_dim(0) + gpu_thread_id(0)
    if t < 4096:
        let i: i64 = t >> 6
        let j: i64 = t & 63
        let mut acc: f32 = 0.0
        for p: i64 in range(64):
            acc = acc + (buffer_get(a, i * 64 + p) as f32) * (buffer_get(b, p * 64 + j) as f32)
        buffer_set(c32, t, acc)
        buffer_set(c16, t, acc as f16)

@gpu(entry)
def matmul_bf16_acc_f32(a: &Buffer[bf16, (4096,), device_global], b: &Buffer[bf16, (4096,), device_global], c32: &mut Buffer[f32, (4096,), device_global], c16: &mut Buffer[bf16, (4096,), device_global]) -> None:
    let t: i64 = gpu_block_id(0) * gpu_block_dim(0) + gpu_thread_id(0)
    if t < 4096:
        let i: i64 = t >> 6
        let j: i64 = t & 63
        let mut acc: f32 = 0.0
        for p: i64 in range(64):
            acc = acc + (buffer_get(a, i * 64 + p) as f32) * (buffer_get(b, p * 64 + j) as f32)
        buffer_set(c32, t, acc)
        buffer_set(c16, t, acc as bf16)

# The same products through the shared-memory tiled path of #2110: 16 x 16
# tiles in workgroup memory, staged as `x as f32` (exact: every f16/bf16 is
# an f32; workgroup memory has no half element type, AX0652), each product
# formed in f32 and added in the same `p` order as the untiled kernel (tile
# `t`, then `q`, is `p = 16 t + q`), so both match the host loop bit for
# bit. Block `g` computes tile row
# `g >> 2`, tile column `g & 3` of the 64 x 64 result; 64 is a whole number
# of tiles, so no lane is padding.
@gpu(entry)
def matmul_f16_tiled_acc_f32(a: &Buffer[f16, (4096,), device_global], b: &Buffer[f16, (4096,), device_global], c32: &mut Buffer[f32, (4096,), device_global], c16: &mut Buffer[f16, (4096,), device_global]) -> None:
    let ta: &mut Buffer[f32, (16, 16), workgroup] = gpu_workgroup_buffer()
    let tb: &mut Buffer[f32, (16, 16), workgroup] = gpu_workgroup_buffer()
    let ty: i64 = gpu_thread_id(0) / 16
    let tx: i64 = gpu_thread_id(0) % 16
    let row: i64 = (gpu_block_id(0) >> 2) * 16 + ty
    let col: i64 = (gpu_block_id(0) & 3) * 16 + tx
    let mut acc: f32 = 0.0
    for t: i64 in range(4):
        buffer_set(ta, ty, tx, buffer_get(a, row * 64 + t * 16 + tx) as f32)
        buffer_set(tb, ty, tx, buffer_get(b, (t * 16 + ty) * 64 + col) as f32)
        # Both tiles are complete before anyone reads them.
        gpu_barrier()
        for q: i64 in range(16):
            acc = acc + buffer_get(ta, ty, q) * buffer_get(tb, q, tx)
        # Everyone is done reading before the next tile overwrites them.
        gpu_barrier()
    buffer_set(c32, row * 64 + col, acc)
    buffer_set(c16, row * 64 + col, acc as f16)

@gpu(entry)
def matmul_bf16_tiled_acc_f32(a: &Buffer[bf16, (4096,), device_global], b: &Buffer[bf16, (4096,), device_global], c32: &mut Buffer[f32, (4096,), device_global], c16: &mut Buffer[bf16, (4096,), device_global]) -> None:
    let ta: &mut Buffer[f32, (16, 16), workgroup] = gpu_workgroup_buffer()
    let tb: &mut Buffer[f32, (16, 16), workgroup] = gpu_workgroup_buffer()
    let ty: i64 = gpu_thread_id(0) / 16
    let tx: i64 = gpu_thread_id(0) % 16
    let row: i64 = (gpu_block_id(0) >> 2) * 16 + ty
    let col: i64 = (gpu_block_id(0) & 3) * 16 + tx
    let mut acc: f32 = 0.0
    for t: i64 in range(4):
        buffer_set(ta, ty, tx, buffer_get(a, row * 64 + t * 16 + tx) as f32)
        buffer_set(tb, ty, tx, buffer_get(b, (t * 16 + ty) * 64 + col) as f32)
        gpu_barrier()
        for q: i64 in range(16):
            acc = acc + buffer_get(ta, ty, q) * buffer_get(tb, q, tx)
        gpu_barrier()
    buffer_set(c32, row * 64 + col, acc)
    buffer_set(c16, row * 64 + col, acc as bf16)

# Row sums of an 8 x 4096 f16 matrix, one thread per row: rounded in an f16
# accumulator (each `+` rounds to f16) versus an explicit f32 accumulator.
@gpu(entry)
def rowsum_f16_acc_f16(x: &Buffer[f16, (32768,), device_global], out: &mut Buffer[f16, (8,), device_global]) -> None:
    let r: i64 = gpu_thread_id(0)
    if r < 8:
        let mut acc: f16 = 0.0
        for p: i64 in range(4096):
            acc = acc + buffer_get(x, r * 4096 + p)
        buffer_set(out, r, acc)

@gpu(entry)
def rowsum_f16_acc_f32(x: &Buffer[f16, (32768,), device_global], out: &mut Buffer[f32, (8,), device_global]) -> None:
    let r: i64 = gpu_thread_id(0)
    if r < 8:
        let mut acc: f32 = 0.0
        for p: i64 in range(4096):
            acc = acc + (buffer_get(x, r * 4096 + p) as f32)
        buffer_set(out, r, acc)

# A workgroup sum of f16 inputs widened explicitly to f32 (the collective
# takes f32, not f16): the strict tier folds in thread order.
@gpu(entry)
@schedule(max_threads=256)
def wgsum_f16_acc_f32(x: &Buffer[f16, (256,), device_global], out: &mut Buffer[f32, (1,), device_global]) -> None:
    let v: f32 = buffer_get(x, gpu_thread_id(0)) as f32
    let s: f32 = gpu_workgroup_sum(v)
    if gpu_thread_id(0) == 0:
        buffer_set(out, 0, s)

def next_seed(s: i64) -> i64:
    return (s * 6364136223846793005 + 1442695040888963407) & 9223372036854775807

# A value in [-4, 4) with 1/256 steps: exact in f16 and in bf16 (9 bits of
# magnitude would not fit bf16, so the bf16 run uses 1/32 steps).
def small(s: i64, steps: i64) -> f32:
    return (((s >> 33) & 2047) - 1024) as f32 / steps as f32

def check_matmul_f16() -> i64:
    let mut s: i64 = 2111
    let mut a: Buffer[f16, (4096,)] = buffer_alloc([4096])
    let mut b: Buffer[f16, (4096,)] = buffer_alloc([4096])
    let mut w32: Buffer[f32, (4096,)] = buffer_alloc([4096])
    let mut w16: Buffer[f16, (4096,)] = buffer_alloc([4096])
    for t: i64 in range(4096):
        s = next_seed(s)
        buffer_set(a, t, small(s, 256) as f16)
        s = next_seed(s)
        buffer_set(b, t, small(s, 256) as f16)
    for t: i64 in range(4096):
        let i: i64 = t >> 6
        let j: i64 = t & 63
        let mut acc: f32 = 0.0
        for p: i64 in range(64):
            acc = acc + (buffer_get(a, i * 64 + p) as f32) * (buffer_get(b, p * 64 + j) as f32)
        buffer_set(w32, t, acc)
        buffer_set(w16, t, acc as f16)
    let mut z32: Buffer[f32, (4096,)] = buffer_alloc([4096])
    let mut z16: Buffer[f16, (4096,)] = buffer_alloc([4096])
    let da: Buffer[f16, (4096,), device_global] = buffer_to_device(a)
    let db: Buffer[f16, (4096,), device_global] = buffer_to_device(b)
    let mut d32: Buffer[f32, (4096,), device_global] = buffer_to_device(z32)
    let mut d16: Buffer[f16, (4096,), device_global] = buffer_to_device(z16)
    gpu_launch(matmul_f16_acc_f32, 32, BLOCK, &da, &db, &mut d32, &mut d16)
    let g32: Buffer[f32, (4096,)] = buffer_to_host(d32)
    let g16: Buffer[f16, (4096,)] = buffer_to_host(d16)
    let mut y32: Buffer[f32, (4096,)] = buffer_alloc([4096])
    let mut y16: Buffer[f16, (4096,)] = buffer_alloc([4096])
    let mut e32: Buffer[f32, (4096,), device_global] = buffer_to_device(y32)
    let mut e16: Buffer[f16, (4096,), device_global] = buffer_to_device(y16)
    gpu_launch(matmul_f16_tiled_acc_f32, 16, 256, &da, &db, &mut e32, &mut e16)
    let t32: Buffer[f32, (4096,)] = buffer_to_host(e32)
    let t16: Buffer[f16, (4096,)] = buffer_to_host(e16)
    let mut bad: i64 = 0
    for t: i64 in range(4096):
        let g: f64 = buffer_get(g32, t) as f64
        let w: f64 = buffer_get(w32, t) as f64
        if not same(g, w):
            bad = bad + report("f16 matmul (f32 acc)", 0, t, g, w)
        let h: f64 = buffer_get(g16, t) as f64
        let v: f64 = buffer_get(w16, t) as f64
        if not same(h, v):
            bad = bad + report("f16 matmul (f16 out)", 1, t, h, v)
        let tg: f64 = buffer_get(t32, t) as f64
        if not same(tg, w):
            bad = bad + report("f16 tiled matmul (f32 acc)", 2, t, tg, w)
        let th: f64 = buffer_get(t16, t) as f64
        if not same(th, v):
            bad = bad + report("f16 tiled matmul (f16 out)", 3, t, th, v)
    return bad

def check_matmul_bf16() -> i64:
    let mut s: i64 = 4222
    let mut a: Buffer[bf16, (4096,)] = buffer_alloc([4096])
    let mut b: Buffer[bf16, (4096,)] = buffer_alloc([4096])
    let mut w32: Buffer[f32, (4096,)] = buffer_alloc([4096])
    let mut w16: Buffer[bf16, (4096,)] = buffer_alloc([4096])
    for t: i64 in range(4096):
        s = next_seed(s)
        buffer_set(a, t, small(s >> 3, 32) as bf16)
        s = next_seed(s)
        buffer_set(b, t, small(s >> 3, 32) as bf16)
    for t: i64 in range(4096):
        let i: i64 = t >> 6
        let j: i64 = t & 63
        let mut acc: f32 = 0.0
        for p: i64 in range(64):
            acc = acc + (buffer_get(a, i * 64 + p) as f32) * (buffer_get(b, p * 64 + j) as f32)
        buffer_set(w32, t, acc)
        buffer_set(w16, t, acc as bf16)
    let mut z32: Buffer[f32, (4096,)] = buffer_alloc([4096])
    let mut z16: Buffer[bf16, (4096,)] = buffer_alloc([4096])
    let da: Buffer[bf16, (4096,), device_global] = buffer_to_device(a)
    let db: Buffer[bf16, (4096,), device_global] = buffer_to_device(b)
    let mut d32: Buffer[f32, (4096,), device_global] = buffer_to_device(z32)
    let mut d16: Buffer[bf16, (4096,), device_global] = buffer_to_device(z16)
    gpu_launch(matmul_bf16_acc_f32, 32, BLOCK, &da, &db, &mut d32, &mut d16)
    let g32: Buffer[f32, (4096,)] = buffer_to_host(d32)
    let g16: Buffer[bf16, (4096,)] = buffer_to_host(d16)
    let mut y32: Buffer[f32, (4096,)] = buffer_alloc([4096])
    let mut y16: Buffer[bf16, (4096,)] = buffer_alloc([4096])
    let mut e32: Buffer[f32, (4096,), device_global] = buffer_to_device(y32)
    let mut e16: Buffer[bf16, (4096,), device_global] = buffer_to_device(y16)
    gpu_launch(matmul_bf16_tiled_acc_f32, 16, 256, &da, &db, &mut e32, &mut e16)
    let t32: Buffer[f32, (4096,)] = buffer_to_host(e32)
    let t16: Buffer[bf16, (4096,)] = buffer_to_host(e16)
    let mut bad: i64 = 0
    for t: i64 in range(4096):
        let g: f64 = buffer_get(g32, t) as f64
        let w: f64 = buffer_get(w32, t) as f64
        if not same(g, w):
            bad = bad + report("bf16 matmul (f32 acc)", 0, t, g, w)
        let h: f64 = buffer_get(g16, t) as f64
        let v: f64 = buffer_get(w16, t) as f64
        if not same(h, v):
            bad = bad + report("bf16 matmul (bf16 out)", 1, t, h, v)
        let tg: f64 = buffer_get(t32, t) as f64
        if not same(tg, w):
            bad = bad + report("bf16 tiled matmul (f32 acc)", 2, t, tg, w)
        let th: f64 = buffer_get(t16, t) as f64
        if not same(th, v):
            bad = bad + report("bf16 tiled matmul (bf16 out)", 3, t, th, v)
    return bad

# Row 0 is 4096 ones: the rounded f16 accumulator stalls at 2048 (2048 + 1
# ties to even, back to 2048) while the f32 accumulator reaches 4096. The
# other rows are pseudo-random and compared with the host.
def check_rowsums() -> i64:
    let mut s: i64 = 6333
    let mut x: Buffer[f16, (32768,)] = buffer_alloc([32768])
    for p: i64 in range(4096):
        buffer_set(x, p, 1.0)
    for t: i64 in range(4096, 32768):
        s = next_seed(s)
        buffer_set(x, t, small(s, 256) as f16)
    let mut w16: Buffer[f16, (8,)] = buffer_alloc([8])
    let mut w32: Buffer[f32, (8,)] = buffer_alloc([8])
    for r: i64 in range(8):
        let mut acc16: f16 = 0.0
        let mut acc32: f32 = 0.0
        for p: i64 in range(4096):
            acc16 = acc16 + buffer_get(x, r * 4096 + p)
            acc32 = acc32 + (buffer_get(x, r * 4096 + p) as f32)
        buffer_set(w16, r, acc16)
        buffer_set(w32, r, acc32)
    let mut z16: Buffer[f16, (8,)] = buffer_alloc([8])
    let mut z32: Buffer[f32, (8,)] = buffer_alloc([8])
    let dx: Buffer[f16, (32768,), device_global] = buffer_to_device(x)
    let mut d16: Buffer[f16, (8,), device_global] = buffer_to_device(z16)
    let mut d32: Buffer[f32, (8,), device_global] = buffer_to_device(z32)
    gpu_launch(rowsum_f16_acc_f16, 1, 32, &dx, &mut d16)
    gpu_launch(rowsum_f16_acc_f32, 1, 32, &dx, &mut d32)
    let g16: Buffer[f16, (8,)] = buffer_to_host(d16)
    let g32: Buffer[f32, (8,)] = buffer_to_host(d32)
    let mut bad: i64 = 0
    for r: i64 in range(8):
        let a: f64 = buffer_get(g16, r) as f64
        let b: f64 = buffer_get(w16, r) as f64
        if not same(a, b):
            bad = bad + report("row sum (f16 acc)", 0, r, a, b)
        let c: f64 = buffer_get(g32, r) as f64
        let d: f64 = buffer_get(w32, r) as f64
        if not same(c, d):
            bad = bad + report("row sum (f32 acc)", 1, r, c, d)
    let stalled: f64 = buffer_get(g16, 0) as f64
    let full: f64 = buffer_get(g32, 0) as f64
    if stalled != 2048.0:
        bad = bad + report("row of ones (f16 acc)", 0, 0, stalled, 2048.0)
    if full != 4096.0:
        bad = bad + report("row of ones (f32 acc)", 1, 0, full, 4096.0)
    return bad

# Inputs that tell the strict fold apart from any other order: even lanes
# are large (16384..32752, multiples of 16, exact in f16), odd lanes small
# (k/256 in [-4, 4), exact in f16), so the running f32 sum climbs past 2^21
# where its ulp (0.25) rounds away part of each small term, and how much is
# lost depends on the order. Every input and the sum are finite, so `same()`
# compares bits, never "both NaN". The host also folds the same values as a
# pairwise tree (the shape a reassociated reduction takes) and fails the
# check if that differs from the sequential fold by less than a bit: if the
# inputs ever stopped discriminating, the check would say so, not pass.
# Seed 8444: sequential 3150440.5, tree 3150441.0, reversed and per-warp
# folds 3150441.25 / 3150440.75, exact sum 3150441.14453125.
def check_wgsum() -> i64:
    let mut s: i64 = 8444
    let mut x: Buffer[f16, (256,)] = buffer_alloc([256])
    let mut tree: Buffer[f32, (256,)] = buffer_alloc([256])
    let mut want: f32 = 0.0
    for t: i64 in range(256):
        s = next_seed(s)
        let mut v: f16 = small(s, 256) as f16
        if t % 2 == 0:
            v = ((((s >> 33) & 1023) * 16 + 16384) as f32) as f16
        buffer_set(x, t, v)
        buffer_set(tree, t, v as f32)
        want = want + (v as f32)
    for lvl: i64 in range(8):
        let width: i64 = 128 >> lvl
        for i: i64 in range(width):
            buffer_set(tree, i, buffer_get(tree, 2 * i) + buffer_get(tree, 2 * i + 1))
    let w: f64 = want as f64
    let other: f64 = buffer_get(tree, 0) as f64
    let mut bad: i64 = 0
    if not (w - w == 0.0):
        bad = bad + report("workgroup sum input (not finite)", 0, 0, w, w)
    if same(w, other):
        bad = bad + report("workgroup sum input (order-blind)", 0, 0, other, w)
    let mut z: Buffer[f32, (1,)] = buffer_alloc([1])
    let dx: Buffer[f16, (256,), device_global] = buffer_to_device(x)
    let mut d: Buffer[f32, (1,), device_global] = buffer_to_device(z)
    gpu_launch(wgsum_f16_acc_f32, 1, 256, &dx, &mut d)
    let g: Buffer[f32, (1,)] = buffer_to_host(d)
    let got: f64 = buffer_get(g, 0) as f64
    if not same(got, w):
        bad = bad + report("workgroup sum (f32 acc)", 0, 0, got, w)
    return bad

# ---- Section 4: constant/runtime agreement ----

# Folded at compile time by the strict constant evaluator.
const THIRD_F16: f16 = 1.0_f16 / 3.0_f16
const THIRD_BF16: bf16 = (1.0 as bf16) / (3.0 as bf16)
const THIRD_F32: f32 = 1.0_f32 / 3.0_f32
const THIRD_F64: f64 = 1.0 / 3.0
const TIE_F16: f16 = 1.0_f16 + 0.00048828125_f16
const TIE_BF16: bf16 = (1.0 as bf16) + (0.00390625 as bf16)
const MULADD_F16: f16 = 1.0009765625_f16 * 1.0009765625_f16 + 1.0009765625_f16

@gpu(entry)
def runtime_values(x: &Buffer[f64, (4,), device_global], out: &mut Buffer[f64, (8,), device_global]) -> None:
    if gpu_thread_id(0) == 0:
        let one: f64 = buffer_get(x, 0)
        let three: f64 = buffer_get(x, 1)
        let hulp16: f64 = buffer_get(x, 2)
        let hulpb: f64 = buffer_get(x, 3)
        buffer_set(out, 0, ((one as f16) / (three as f16)) as f64)
        buffer_set(out, 1, ((one as bf16) / (three as bf16)) as f64)
        buffer_set(out, 2, ((one as f32) / (three as f32)) as f64)
        buffer_set(out, 3, one / three)
        buffer_set(out, 4, ((one as f16) + (hulp16 as f16)) as f64)
        buffer_set(out, 5, ((one as bf16) + (hulpb as bf16)) as f64)
        let m: f16 = (one as f16) + (hulp16 as f16) * 2.0_f16
        buffer_set(out, 6, (m * m + m) as f64)

def check_constants() -> i64:
    let mut x: Buffer[f64, (4,)] = buffer_alloc([4])
    buffer_set(x, 0, 1.0)
    buffer_set(x, 1, 3.0)
    buffer_set(x, 2, 0.00048828125)
    buffer_set(x, 3, 0.00390625)
    let mut z: Buffer[f64, (8,)] = buffer_alloc([8])
    let dx: Buffer[f64, (4,), device_global] = buffer_to_device(x)
    let mut d: Buffer[f64, (8,), device_global] = buffer_to_device(z)
    gpu_launch(runtime_values, 1, 32, &dx, &mut d)
    let g: Buffer[f64, (8,)] = buffer_to_host(d)
    let want: Array[f64; 7] = [THIRD_F16 as f64, THIRD_BF16 as f64, THIRD_F32 as f64, THIRD_F64, TIE_F16 as f64, TIE_BF16 as f64, MULADD_F16 as f64]
    let mut bad: i64 = 0
    for i: i64 in range(7):
        let got: f64 = buffer_get(g, i)
        if not same(got, want[i]):
            bad = bad + report("constant vs gpu", i, 0, got, want[i])
    return bad

def main() -> i32:
    let arith: i64 = check_same_op() + check_arith_f16() + check_arith_bf16() + check_arith_f32() + check_arith_f64()
    let cvt: i64 = check_cvt_f16() + check_cvt_bf16() + check_cvt_f32() + check_cvt_f64() + check_cvt_i64() + check_cvt_u64()
    let acc: i64 = check_matmul_f16() + check_matmul_bf16() + check_rowsums() + check_wgsum()
    let consts: i64 = check_constants()
    println!("arithmetic: {arith} mismatches")
    println!("conversions: {cvt} mismatches")
    println!("accumulation: {acc} mismatches")
    println!("constants: {consts} mismatches")
    if arith + cvt + acc + consts != 0:
        return 1
    println!("numeric: f16, bf16, f32 and f64 arithmetic, conversions and f32 accumulation match the strict host and the fixtures")
    return 0
