# The strict host result of every op on `(x, y)`, stored at lane `i`.
def ref_arith_f16(x: f16, y: f16, i: i64, out: Buffer[f16, (4608,)]) -> Buffer[f16, (4608,)]:
    let mut o: Buffer[f16, (4608,)] = out
    buffer_set(o, i, x + y)
    buffer_set(o, 512 + i, x - y)
    buffer_set(o, 1024 + i, x * y)
    buffer_set(o, 1536 + i, x / y)
    buffer_set(o, 2048 + i, x * y + x)
    buffer_set(o, 2560 + i, math_sqrt(x))
    buffer_set(o, 3072 + i, -x)
    buffer_set(o, 3584 + i, math_fmin(x, y))
    buffer_set(o, 4096 + i, math_fmax(x, y))
    return o

# The six comparisons of `(x, y)` as bits (1 <, 2 <=, 4 ==, 8 !=, 16 >, 32 >=).
def ref_cmp_f16(x: f16, y: f16) -> i32:
    let mut c: i32 = 0
    if x < y:
        c = c + 1
    if x <= y:
        c = c + 2
    if x == y:
        c = c + 4
    if x != y:
        c = c + 8
    if x > y:
        c = c + 16
    if x >= y:
        c = c + 32
    return c

