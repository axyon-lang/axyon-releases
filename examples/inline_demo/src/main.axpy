# `@inline` demo (#1741): the three supported forms.
import axyon.debug as D

@inline
def square(x: i32) -> i32:
    return x * x

@inline(always)
def lerp(a: i32, b: i32, t: i32) -> i32:
    return a + (b - a) * t

@inline(never)
def report(code: i32) -> i32:
    D.println("code: {code}")
    return code

def main() -> i32:
    let s: i32 = square(7)
    let l: i32 = lerp(10, 20, 2)
    let r: i32 = report(s + l)
    if r != 79:
        return 1
    return 0
