# T.argmax / T.argmin along an axis (issue #1536): the index of the largest
# (smallest) element, as a Tensor[i64, ...] with the reduced axis removed.
# Ties return the first index; a NaN is picked over any number.

import std.tensor as T

def main() -> i32:
    # Rows [0.5, 2, 2] and [-1, 3, 0]
    let mut flat: Tensor[f32, (6,)] = T.zeros([6])
    flat[0] = 0.5
    flat[1] = 2.0
    flat[2] = 2.0
    flat[3] = -1.0
    flat[4] = 3.0
    flat[5] = 0.0
    let logits: Tensor[f32, (2, 3)] = T.reshape(flat, [2, 3])

    let best: Tensor[i64, (2,)] = T.argmax(logits, 1)
    println!("argmax along axis 1: {} {}", best[0], best[1])

    let worst: Tensor[i64, (3,)] = T.argmin(logits, 0)
    println!("argmin along axis 0: {} {} {}", worst[0], worst[1], worst[2])

    if best[0] != 1_i64:
        return 1
    if best[1] != 1_i64:
        return 2
    if worst[0] != 1_i64 or worst[1] != 0_i64 or worst[2] != 1_i64:
        return 3
    return 0
