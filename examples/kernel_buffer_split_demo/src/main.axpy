# One launch over two disjoint halves of one device buffer (issue #2706)
#
# `buffer_split_mut(&mut d, mid)` borrows the `device_global` buffer `d`
# once and fills two consecutive kernel parameters with rows `0..mid` and
# `mid..n`. The halves cannot overlap, so one kernel may read one half and
# write the other in the same launch; two views of `d`
# (`buffer_view(&d, ..)` and `buffer_view_mut(&mut d, ..)`) are refused
# there (`AX0499`). `mid` outside `0..=n` is an AXYON panic before the launch.
#
# Running it needs an NVIDIA GPU and driver; without one the first device
# allocation stops the program with an AXYON panic.

@gpu(entry)
def double_into(src: &Buffer[f32, (N,), device_global], dst: &mut Buffer[f32, (M,), device_global]) -> None:
    let i: i64 = gpu_block_id(0) * gpu_block_dim(0) + gpu_thread_id(0)
    # Each half's `buffer_dim` is its own length.
    if i < buffer_dim(dst, 0) and i < buffer_dim(src, 0):
        buffer_set(dst, i, buffer_get(src, i) * 2.0)

def main() -> i32:
    let n: i64 = 8
    let mut h: Buffer[f32, (N,)] = buffer_alloc([n])
    for i: i64 in range(n):
        buffer_set(h, i, (i + 1) as f32)
    let mut d: Buffer[f32, (N,), device_global] = buffer_to_device(h)

    # Read rows 0..4 of `d` and write rows 4..8 of the same buffer.
    gpu_launch(double_into, 1, 32, buffer_split_mut(&mut d, 4))

    let back: Buffer[f32, (N,)] = buffer_to_host(d)
    for i: i64 in range(n):
        let v: f32 = buffer_get(back, i)
        println!("d[{i}] = {v}")
    return 0
