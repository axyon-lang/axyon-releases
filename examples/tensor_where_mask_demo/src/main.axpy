# Elementwise tensor comparisons, logical ops and T.where (issue #3242):
# build a Tensor[bool] mask with T.gt / T.lt, combine masks with
# T.logical_and / T.logical_or / T.logical_not, and select between two
# tensors with T.where. Every op broadcasts like T.add.

import std.tensor as T

def main() -> i32:
    # scores: rows [0.5, 2, -1] and [3, 0, 1.5]
    let mut flat: Tensor[f32, (6,)] = T.zeros([6])
    flat[0] = 0.5
    flat[1] = 2.0
    flat[2] = -1.0
    flat[3] = 3.0
    flat[4] = 0.0
    flat[5] = 1.5
    let scores: Tensor[f32, (2, 3)] = T.reshape(flat, [2, 3])

    # A one-element tensor broadcasts against every score.
    let low: Tensor[f32, (1,)] = T.full([1], 0.25)
    let high: Tensor[f32, (1,)] = T.full([1], 2.5)
    let above: Tensor[bool, (2, 3)] = T.gt(scores, low)
    let below: Tensor[bool, (2, 3)] = T.lt(scores, high)
    let in_band: Tensor[bool, (2, 3)] = T.logical_and(above, below)
    let outside: Tensor[bool, (2, 3)] = T.logical_not(in_band)
    let either: Tensor[bool, (2, 3)] = T.logical_or(in_band, outside)

    # Mask out-of-band scores with a large negative value (as an attention
    # mask would before a softmax).
    let neg: Tensor[f32, (1,)] = T.full([1], -1.0e9)
    let masked: Tensor[f32, (2, 3)] = T.where(in_band, scores, neg)
    println!("row 0: {} {} {}", masked[0, 0], masked[0, 1], masked[0, 2])
    println!("row 1: {} {} {}", masked[1, 0], masked[1, 1], masked[1, 2])

    # Row 0: 0.5 and 2 are in (0.25, 2.5); -1 is not.
    if not in_band[0, 0] or not in_band[0, 1] or in_band[0, 2]:
        return 1
    # Row 1: 3 and 0 are outside; 1.5 is inside.
    if not outside[1, 0] or not outside[1, 1] or outside[1, 2]:
        return 2
    if not either[0, 2] or not either[1, 2]:
        return 3
    if masked[0, 1] != 2.0 or masked[0, 2] != -1.0e9 or masked[1, 2] != 1.5:
        return 4
    return 0
