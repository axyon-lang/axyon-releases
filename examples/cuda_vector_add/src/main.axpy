# Vector add and elementwise kernels on an NVIDIA GPU (issue #2108)
#
# Every step runs for real: the host fills buffers from a fixed-seed
# generator, copies them to the device, launches compiler-generated PTX
# kernels, copies the results back and checks each element against a host
# reference. Integer results are exact (two's-complement wrapping, the same
# as the host); f32 addition and multiplication round to nearest-even with
# no flush-to-zero and no fused multiply-add, so they match the host bit for
# bit, special values included.
#
# The buffers have a static capacity (`CAP` elements); each launch processes
# its first `n`. (Run-time-extent buffer parameters also work, #2634; this
# example keeps static shapes.) The grid is rounded up to whole blocks, so the last block
# has tail lanes past `n`: they skip the access (`if i < n`). A launch of
# zero blocks is zero work.
#
# Set `AXYON_GPU_LAUNCH_EVIDENCE=1` to see, for each launch, the backend,
# the device it actually ran on and a fingerprint of the image. Without a
# CUDA device the first device allocation stops the program with an AXYON
# panic: there is no CPU fallback.

@gpu(entry)
def add_i32(n: i64, x: &Buffer[i32, (4099,), device_global], y: &Buffer[i32, (4099,), device_global], out: &mut Buffer[i32, (4099,), device_global]) -> None:
    let i: i64 = gpu_block_id(0) * gpu_block_dim(0) + gpu_thread_id(0)
    if i < n:
        buffer_set(out, i, buffer_get(x, i) + buffer_get(y, i))

@gpu(entry)
def add_u32(n: i64, x: &Buffer[u32, (4099,), device_global], y: &Buffer[u32, (4099,), device_global], out: &mut Buffer[u32, (4099,), device_global]) -> None:
    let i: i64 = gpu_block_id(0) * gpu_block_dim(0) + gpu_thread_id(0)
    if i < n:
        buffer_set(out, i, buffer_get(x, i) + buffer_get(y, i))

@gpu(entry)
def add_i64(n: i64, x: &Buffer[i64, (4099,), device_global], y: &Buffer[i64, (4099,), device_global], out: &mut Buffer[i64, (4099,), device_global]) -> None:
    let i: i64 = gpu_block_id(0) * gpu_block_dim(0) + gpu_thread_id(0)
    if i < n:
        buffer_set(out, i, buffer_get(x, i) + buffer_get(y, i))

@gpu(entry)
def add_f32(n: i64, x: &Buffer[f32, (4099,), device_global], y: &Buffer[f32, (4099,), device_global], out: &mut Buffer[f32, (4099,), device_global]) -> None:
    let i: i64 = gpu_block_id(0) * gpu_block_dim(0) + gpu_thread_id(0)
    if i < n:
        buffer_set(out, i, buffer_get(x, i) + buffer_get(y, i))

# Elementwise: out[i] = (x[i] as f32) * scale + bias, an i32 -> f32
# conversion, then a rounded multiply and a rounded add (never fused).
@gpu(entry)
def scale_bias(n: i64, scale: f32, bias: f32, x: &Buffer[i32, (4099,), device_global], out: &mut Buffer[f32, (4099,), device_global]) -> None:
    let i: i64 = gpu_block_id(0) * gpu_block_dim(0) + gpu_thread_id(0)
    if i < n:
        let v: f32 = buffer_get(x, i) as f32
        buffer_set(out, i, v * scale + bias)

const CAP: i64 = 4099
const BLOCK: i64 = 128

# A fixed-seed linear congruential generator: the same inputs every run.
def next_seed(s: i64) -> i64:
    return (s * 6364136223846793005 + 1442695040888963407) & 9223372036854775807

def blocks_for(n: i64) -> i64:
    return (n + BLOCK - 1) / BLOCK

# Vector add over i32, u32 and i64 for length `n`; returns the mismatches.
def check_ints(n: i64, seed: i64) -> i64:
    let mut s: i64 = seed
    let mut x32: Buffer[i32, (4099,)] = buffer_alloc([4099])
    let mut y32: Buffer[i32, (4099,)] = buffer_alloc([4099])
    let mut xu: Buffer[u32, (4099,)] = buffer_alloc([4099])
    let mut yu: Buffer[u32, (4099,)] = buffer_alloc([4099])
    let mut x64: Buffer[i64, (4099,)] = buffer_alloc([4099])
    let mut y64: Buffer[i64, (4099,)] = buffer_alloc([4099])
    let mut o32: Buffer[i32, (4099,)] = buffer_alloc([4099])
    let mut ou: Buffer[u32, (4099,)] = buffer_alloc([4099])
    let mut o64: Buffer[i64, (4099,)] = buffer_alloc([4099])
    for i: i64 in range(CAP):
        s = next_seed(s)
        let a: i64 = s
        s = next_seed(s)
        let b: i64 = s
        buffer_set(x32, i, a as i32)
        buffer_set(y32, i, b as i32)
        buffer_set(xu, i, a as u32)
        buffer_set(yu, i, b as u32)
        buffer_set(x64, i, a)
        buffer_set(y64, i, b)
        # Sentinels: lanes at and past `n` must keep them.
        buffer_set(o32, i, -7)
        buffer_set(ou, i, 7)
        buffer_set(o64, i, -7)
    # The host reference, computed before the inputs move to the device.
    let mut r32: Buffer[i32, (4099,)] = buffer_alloc([4099])
    let mut ru: Buffer[u32, (4099,)] = buffer_alloc([4099])
    let mut r64: Buffer[i64, (4099,)] = buffer_alloc([4099])
    for i: i64 in range(CAP):
        buffer_set(r32, i, buffer_get(x32, i) + buffer_get(y32, i))
        buffer_set(ru, i, buffer_get(xu, i) + buffer_get(yu, i))
        buffer_set(r64, i, buffer_get(x64, i) + buffer_get(y64, i))
    let dx32: Buffer[i32, (4099,), device_global] = buffer_to_device(x32)
    let dy32: Buffer[i32, (4099,), device_global] = buffer_to_device(y32)
    let mut do32: Buffer[i32, (4099,), device_global] = buffer_to_device(o32)
    let dxu: Buffer[u32, (4099,), device_global] = buffer_to_device(xu)
    let dyu: Buffer[u32, (4099,), device_global] = buffer_to_device(yu)
    let mut dou: Buffer[u32, (4099,), device_global] = buffer_to_device(ou)
    let dx64: Buffer[i64, (4099,), device_global] = buffer_to_device(x64)
    let dy64: Buffer[i64, (4099,), device_global] = buffer_to_device(y64)
    let mut do64: Buffer[i64, (4099,), device_global] = buffer_to_device(o64)
    gpu_launch(add_i32, blocks_for(n), BLOCK, n, &dx32, &dy32, &mut do32)
    gpu_launch(add_u32, blocks_for(n), BLOCK, n, &dxu, &dyu, &mut dou)
    gpu_launch(add_i64, blocks_for(n), BLOCK, n, &dx64, &dy64, &mut do64)
    let b32: Buffer[i32, (4099,)] = buffer_to_host(do32)
    let bu: Buffer[u32, (4099,)] = buffer_to_host(dou)
    let b64: Buffer[i64, (4099,)] = buffer_to_host(do64)
    let mut bad: i64 = 0
    for i: i64 in range(CAP):
        let mut w32: i32 = -7
        let mut wu: u32 = 7
        let mut w64: i64 = -7
        if i < n:
            w32 = buffer_get(r32, i)
            wu = buffer_get(ru, i)
            w64 = buffer_get(r64, i)
        if buffer_get(b32, i) != w32:
            bad = bad + 1
        if buffer_get(bu, i) != wu:
            bad = bad + 1
        if buffer_get(b64, i) != w64:
            bad = bad + 1
    return bad

# f32 vector add and the elementwise kernel for length `n`.
def check_floats(n: i64, seed: i64) -> i64:
    let mut s: i64 = seed
    let mut x: Buffer[f32, (4099,)] = buffer_alloc([4099])
    let mut y: Buffer[f32, (4099,)] = buffer_alloc([4099])
    let mut xi: Buffer[i32, (4099,)] = buffer_alloc([4099])
    let mut o: Buffer[f32, (4099,)] = buffer_alloc([4099])
    let mut o2: Buffer[f32, (4099,)] = buffer_alloc([4099])
    for i: i64 in range(CAP):
        s = next_seed(s)
        # Values in [-2^20, 2^20) with 1/256 steps: the sums round.
        let a: f32 = (((s >> 20) & 536870911) - 268435456) as f32 / 256.0
        s = next_seed(s)
        let b: f32 = (((s >> 20) & 536870911) - 268435456) as f32 / 3.0
        buffer_set(x, i, a)
        buffer_set(y, i, b)
        buffer_set(xi, i, (s >> 33) as i32)
        buffer_set(o, i, -1.0)
        buffer_set(o2, i, -1.0)
    let mut r: Buffer[f32, (4099,)] = buffer_alloc([4099])
    let mut r2: Buffer[f32, (4099,)] = buffer_alloc([4099])
    for i: i64 in range(CAP):
        buffer_set(r, i, buffer_get(x, i) + buffer_get(y, i))
        let v: f32 = buffer_get(xi, i) as f32
        buffer_set(r2, i, v * 0.1 + 3.0)
    let dx: Buffer[f32, (4099,), device_global] = buffer_to_device(x)
    let dy: Buffer[f32, (4099,), device_global] = buffer_to_device(y)
    let dxi: Buffer[i32, (4099,), device_global] = buffer_to_device(xi)
    let mut d_o: Buffer[f32, (4099,), device_global] = buffer_to_device(o)
    let mut d_o2: Buffer[f32, (4099,), device_global] = buffer_to_device(o2)
    gpu_launch(add_f32, blocks_for(n), BLOCK, n, &dx, &dy, &mut d_o)
    gpu_launch(scale_bias, blocks_for(n), BLOCK, n, 0.1, 3.0, &dxi, &mut d_o2)
    let b: Buffer[f32, (4099,)] = buffer_to_host(d_o)
    let b2: Buffer[f32, (4099,)] = buffer_to_host(d_o2)
    let mut bad: i64 = 0
    for i: i64 in range(CAP):
        let mut w: f32 = -1.0
        let mut w2: f32 = -1.0
        if i < n:
            w = buffer_get(r, i)
            w2 = buffer_get(r2, i)
        if buffer_get(b, i) != w:
            bad = bad + 1
        if buffer_get(b2, i) != w2:
            bad = bad + 1
    return bad

def main() -> i32:
    # Zero, one, small, a non-divisible tail, one full block, and the whole
    # (irregular) capacity: 4099 = 32 * 128 + 3.
    let lengths: Array[i64; 6] = [0, 1, 7, 1000, 128, 4099]
    let mut total: i64 = 0
    for k: i64 in range(6):
        let n: i64 = lengths[k]
        let bad: i64 = check_ints(n, 2108 + k) + check_floats(n, 4216 + k)
        if bad != 0:
            println!("n = {n}: {bad} mismatches")
        total = total + bad
    if total != 0:
        return 1
    println!("vector add and elementwise kernels: all lengths match the host reference")
    return 0
