def main() -> i32:
    """Entry point demonstrating disjoint borrow syntax."""
    println!("Disjoint tensor borrows demo")
    println!("")
    println!("AXYON allows multiple mutable borrows of a tensor")
    println!("when the slices are DISJOINT (non-overlapping).")
    println!("")
    println!("Example - allowed:")
    println!("  let left = &mut t[0:50]")
    println!("  let right = &mut t[50:100]")
    println!("")
    println!("Example - ERROR (overlapping):")
    println!("  let a = &mut t[0:60]")
    println!("  let b = &mut t[40:100]  # Overlaps!")
    println!("")
    println!("The borrow checker uses SliceRange to detect overlaps.")
    return 0
