from std.time import Duration, Instant, SystemTime

@host
def main() -> i32:
    let a: Duration = Duration.from_secs(2_i64)
    let b: Duration = Duration.from_millis(500_i64)
    let c: Duration = a.add(b)
    assert!(c.as_millis() == 2500_i64, "add")
    assert!(a.sub(c).is_zero(), "sat")
    assert!(c.as_secs() == 2_i64, "secs")
    assert!(Duration.from_nanos(-1_i64).as_nanos() == 0_i64, "neg from_nanos")
    assert!(Duration.from_secs(-3_i64).is_zero(), "neg from_secs")
    assert!(a.mul(-2_i64).is_zero(), "neg mul")
    assert!(a.mul(3_i64).as_secs() == 6_i64, "mul")
    assert!(a.div(-1_i64).is_zero(), "neg div")
    assert!(a.div(4_i64).as_millis() == 500_i64, "div")
    let max_ns: i64 = 9223372036854775807_i64
    assert!(Duration.from_secs(9223372037_i64).as_nanos() == max_ns, "from_secs sat")
    assert!(Duration.from_secs(9223372036_i64).as_nanos() == 9223372036000000000_i64, "from_secs edge")
    assert!(Duration.from_millis(9223372036855_i64).as_nanos() == max_ns, "from_millis sat")
    assert!(Duration.from_millis(9223372036854_i64).as_nanos() == 9223372036854000000_i64, "from_millis edge")
    let big: Duration = Duration.from_nanos(max_ns)
    assert!(big.add(Duration.from_nanos(1_i64)).as_nanos() == max_ns, "add sat")
    assert!(big.add(big).as_nanos() == max_ns, "add sat big")
    assert!(Duration.from_nanos(max_ns - 1_i64).add(Duration.from_nanos(1_i64)).as_nanos() == max_ns, "add edge")
    assert!(big.mul(2_i64).as_nanos() == max_ns, "mul sat")
    assert!(Duration.from_secs(5_i64).mul(9223372036_i64).as_nanos() == max_ns, "mul sat2")
    assert!(Duration.from_nanos(1_i64).mul(max_ns).as_nanos() == max_ns, "mul edge")
    assert!(Instant.now().add(big).duration_since(Instant.now()).as_nanos() >= 0_i64, "instant add sat")
    assert!(SystemTime.now().add(big).since_epoch().as_nanos() == max_ns, "systime add sat")
    let pre: SystemTime = SystemTime.unix_epoch()
    let post: SystemTime = pre.add(a)
    assert!(pre.duration_since(post).is_zero(), "pre-epoch diff")
    assert!(post.duration_since(pre).as_secs() == 2_i64, "post diff")
    let before: SystemTime = SystemTime.unix_epoch().add(Duration.zero())
    assert!(before.since_epoch().is_zero(), "since_epoch zero")
    let min_ns: i64 = -9223372036854775807_i64 - 1_i64
    let neg1: SystemTime = SystemTime.from_unix_nanos(-1_i64)
    let hi: SystemTime = SystemTime.from_unix_nanos(max_ns)
    let lo: SystemTime = SystemTime.from_unix_nanos(min_ns)
    assert!(hi.duration_since(neg1).as_nanos() == max_ns, "signed span sat")
    assert!(neg1.duration_since(hi).is_zero(), "signed span reversed")
    assert!(hi.duration_since(lo).as_nanos() == max_ns, "full range sat")
    assert!(lo.duration_since(hi).is_zero(), "full range reversed")
    assert!(neg1.duration_since(lo).as_nanos() == max_ns, "neg1 minus min")
    assert!(lo.duration_since(neg1).is_zero(), "min minus neg1")
    assert!(SystemTime.from_unix_nanos(5_i64).duration_since(SystemTime.from_unix_nanos(-5_i64)).as_nanos() == 10_i64, "signed small")
    let ihi: Instant = Instant.from_nanos(max_ns)
    let ineg: Instant = Instant.from_nanos(-1_i64)
    assert!(ihi.duration_since(ineg).as_nanos() == max_ns, "instant span sat")
    assert!(ineg.duration_since(ihi).is_zero(), "instant span reversed")
    let t0: Instant = Instant.now()
    let e: Duration = t0.elapsed()
    assert!(e.as_nanos() >= 0_i64, "elapsed")
    let w: SystemTime = SystemTime.now()
    assert!(w.duration_since(SystemTime.unix_epoch()).as_secs() > 1700000000_i64, "wall")
    return 0
