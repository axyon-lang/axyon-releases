# Complex c64 scalars and device buffers on an AMD GPU (issue #2874)
#
# The ROCm twin of `examples/cuda_complex` (#2827). Every kernel runs on the
# device and every result is compared bit for bit (any NaN matches any NaN;
# payloads are not part of the contract) with the strict host build of the
# same expression, over every pair of a 12-value component table (zeros of
# both signs, a subnormal, large and huge values, infinities, NaN), so 144
# lanes:
#
# - construction `c64(re, im)` from two device float buffers;
# - a `Buffer[c64, (..), device_global]` element read and write (numeric
#   contract §10 layout `{re, im}`, align of the component, GPU buffer
#   contract element code 16);
# - `.re` / `.im`, `+`, `-`, `*` (componentwise, every product and sum
#   rounded on its own, never fused), unary `-`, `.conj()`, `==` / `!=`;
# - a `@gpu` helper taking and returning complex values;
# - `==` / `!=` again over a dedicated pair table (`cmp_c64`), because the
#   144-lane table above never yields an equal pair: equal finite operands,
#   zeros of opposite sign in either component (equal), operands differing in
#   exactly one component, NaN in either or both components (unequal, even
#   against itself), infinities and an unflushed subnormal. Each lane is
#   checked against a hand-written expected outcome as well as the host, so
#   a constant comparison result cannot pass.
#
# `c128` is not provided on `rocdl-gfx942` (its `f64` component has no AMD
# evidence yet), and complex division, `abs`, `as` conversions, by-value
# complex kernel arguments, complex atomics and complex workgroup memory
# stay rejected in device code (docs/known-limitations/2874-*.md).

const BLOCK: i64 = 128

# The same value: equal bit patterns, or both NaN. The bits keep the sign of
# zero.
def same(x: f64, y: f64) -> bool:
    if x != x:
        return y != y
    return x.to_bits() == y.to_bits()

def report(what: str, op: i64, i: i64, got: f64, want: f64) -> i64:
    println!("{what} mismatch: op {op} lane {i}: got {got}, want {want}")
    return 1

# The component table of `c64`.
def table_c64(k: i64) -> f32:
    if k == 0:
        return 0.0_f32
    if k == 1:
        return -0.0_f32
    if k == 2:
        return 1.0_f32
    if k == 3:
        return -1.5_f32
    if k == 4:
        return 3.25_f32
    if k == 5:
        return f32.from_bits(1_u32)
    if k == 6:
        return 1.0e30_f32
    if k == 7:
        return -3.0e38_f32
    if k == 8:
        return f32.from_bits(2139095040_u32)
    if k == 9:
        return f32.from_bits(4286578688_u32)
    if k == 10:
        return f32.from_bits(2143289344_u32)
    if k == 11:
        return 0.1_f32
    return 0.0_f32

@gpu
def mul_c64(x: c64, y: c64) -> c64:
    return x * y

@gpu(entry)
def ops_c64(n: i64, xr: &Buffer[f32, (144,), device_global], xi: &Buffer[f32, (144,), device_global], b: &Buffer[c64, (144,), device_global], out: &mut Buffer[c64, (864,), device_global], parts: &mut Buffer[f32, (288,), device_global], cmp: &mut Buffer[i32, (144,), device_global]) -> None:
    let i: i64 = gpu_block_id(0) * gpu_block_dim(0) + gpu_thread_id(0)
    if i < n:
        let x: c64 = c64(buffer_get(xr, i), buffer_get(xi, i))
        let y: c64 = buffer_get(b, i)
        buffer_set(out, i, x + y)
        buffer_set(out, 144 + i, x - y)
        buffer_set(out, 288 + i, x * y)
        buffer_set(out, 432 + i, x.conj())
        buffer_set(out, 576 + i, -x)
        buffer_set(out, 720 + i, mul_c64(x, y))
        buffer_set(parts, i, y.re)
        buffer_set(parts, 144 + i, y.im)
        let mut c: i32 = 0
        if x == y:
            c = c + 1
        if x != y:
            c = c + 2
        buffer_set(cmp, i, c)

# The comparison pairs: lane `k` compares `cmp_lhs(k)` with `cmp_rhs(k)`,
# and `cmp_want(k)` is the expected code (1: `==` holds, 2: `!=` holds).
const CMP_N: i64 = 16

def cmp_lhs(k: i64) -> c64:
    let nan: f32 = f32.from_bits(2143289344_u32)
    let inf: f32 = f32.from_bits(2139095040_u32)
    let sub: f32 = f32.from_bits(1_u32)
    if k == 0:
        return c64(1.0_f32, 2.0_f32)
    if k == 1:
        return c64(0.0_f32, 0.0_f32)
    if k == 2:
        return c64(0.0_f32, -0.0_f32)
    if k == 3:
        return c64(-0.0_f32, -0.0_f32)
    if k == 4:
        return c64(1.0_f32, 2.0_f32)
    if k == 5:
        return c64(1.0_f32, 2.0_f32)
    if k == 6:
        return c64(nan, 0.0_f32)
    if k == 7:
        return c64(0.0_f32, nan)
    if k == 8:
        return c64(nan, 1.0_f32)
    if k == 9:
        return c64(inf, -inf)
    if k == 10:
        return c64(sub, 3.25_f32)
    if k == 11:
        return c64(sub, 0.0_f32)
    if k == 12:
        return c64(-3.0e38_f32, 0.1_f32)
    if k == 13:
        return c64(nan, nan)
    if k == 14:
        return c64(inf, 0.0_f32)
    return c64(0.1_f32, 1.0_f32)

def cmp_rhs(k: i64) -> c64:
    let nan: f32 = f32.from_bits(2143289344_u32)
    let inf: f32 = f32.from_bits(2139095040_u32)
    let sub: f32 = f32.from_bits(1_u32)
    if k == 0:
        return c64(1.0_f32, 2.0_f32)
    if k == 1:
        return c64(-0.0_f32, 0.0_f32)
    if k == 2:
        return c64(0.0_f32, 0.0_f32)
    if k == 3:
        return c64(0.0_f32, 0.0_f32)
    if k == 4:
        return c64(1.5_f32, 2.0_f32)
    if k == 5:
        return c64(1.0_f32, 2.5_f32)
    if k == 6:
        return c64(nan, 0.0_f32)
    if k == 7:
        return c64(0.0_f32, nan)
    if k == 8:
        return c64(1.0_f32, 1.0_f32)
    if k == 9:
        return c64(inf, -inf)
    if k == 10:
        return c64(sub, 3.25_f32)
    if k == 11:
        return c64(0.0_f32, 0.0_f32)
    if k == 12:
        return c64(-3.0e38_f32, 0.1_f32)
    if k == 13:
        return c64(nan, nan)
    if k == 14:
        return c64(-inf, 0.0_f32)
    return c64(0.1_f32, -1.0_f32)

# Equal: identical finite values, signed zeros in re, im or both, equal
# infinities, an identical subnormal, identical large values.
def cmp_want(k: i64) -> i32:
    if k == 0 or k == 1 or k == 2 or k == 3 or k == 9 or k == 10 or k == 12:
        return 1
    return 2

@gpu(entry)
def cmp_c64(n: i64, a: &Buffer[c64, (16,), device_global], b: &Buffer[c64, (16,), device_global], cmp: &mut Buffer[i32, (16,), device_global]) -> None:
    let i: i64 = gpu_block_id(0) * gpu_block_dim(0) + gpu_thread_id(0)
    if i < n:
        let x: c64 = buffer_get(a, i)
        let y: c64 = buffer_get(b, i)
        let mut c: i32 = 0
        if x == y:
            c = c + 1
        if x != y:
            c = c + 2
        buffer_set(cmp, i, c)

# Both comparison outcomes on the device against the expected codes and the
# strict host. Prints how many lanes compared equal and unequal.
def check_cmp_c64() -> i64:
    let mut a: Buffer[c64, (16,)] = buffer_alloc([16])
    let mut b: Buffer[c64, (16,)] = buffer_alloc([16])
    let sentinel: Buffer[i32, (16,)] = buffer_alloc([16])
    let mut bad: i64 = 0
    for k: i64 in range(CMP_N):
        let x: c64 = cmp_lhs(k)
        let y: c64 = cmp_rhs(k)
        buffer_set(a, k, x)
        buffer_set(b, k, y)
        let mut c: i32 = 0
        if x == y:
            c = c + 1
        if x != y:
            c = c + 2
        if c != cmp_want(k):
            bad = bad + report("c64 host compare", 8, k, c as f64, cmp_want(k) as f64)
    let da: Buffer[c64, (16,), device_global] = buffer_to_device(a)
    let db: Buffer[c64, (16,), device_global] = buffer_to_device(b)
    let mut dcmp: Buffer[i32, (16,), device_global] = buffer_to_device(sentinel)
    gpu_launch(cmp_c64, 1, BLOCK, CMP_N, &da, &db, &mut dcmp)
    let got: Buffer[i32, (16,)] = buffer_to_host(dcmp)
    let mut eq: i64 = 0
    let mut ne: i64 = 0
    for k: i64 in range(CMP_N):
        let g: i32 = buffer_get(got, k)
        if g == 1:
            eq = eq + 1
        if g == 2:
            ne = ne + 1
        if g != cmp_want(k):
            bad = bad + report("c64 device compare", 8, k, g as f64, cmp_want(k) as f64)
    println!("c64 compare: {eq} equal, {ne} unequal")
    if eq == 0 or ne == 0:
        println!("c64 compare mismatch: both outcomes must occur")
        bad = bad + 1
    return bad

# Every operation of `ops_c64` on the device against the host, lane by lane.
def check_c64() -> i64:
    let mut xr: Buffer[f32, (144,)] = buffer_alloc([144])
    let mut xi: Buffer[f32, (144,)] = buffer_alloc([144])
    let mut b: Buffer[c64, (144,)] = buffer_alloc([144])
    let mut want: Buffer[c64, (864,)] = buffer_alloc([864])
    let mut wparts: Buffer[f32, (288,)] = buffer_alloc([288])
    let mut wcmp: Buffer[i32, (144,)] = buffer_alloc([144])
    let sentinel: Buffer[c64, (864,)] = buffer_alloc([864])
    let psentinel: Buffer[f32, (288,)] = buffer_alloc([288])
    let csentinel: Buffer[i32, (144,)] = buffer_alloc([144])
    let mut n: i64 = 0
    for p: i64 in range(12):
        for q: i64 in range(12):
            let x: c64 = c64(table_c64(p), table_c64(q))
            let y: c64 = c64(table_c64(q), table_c64((p + 5) % 12))
            buffer_set(xr, n, x.re)
            buffer_set(xi, n, x.im)
            buffer_set(b, n, y)
            buffer_set(want, n, x + y)
            buffer_set(want, 144 + n, x - y)
            buffer_set(want, 288 + n, x * y)
            buffer_set(want, 432 + n, x.conj())
            buffer_set(want, 576 + n, -x)
            buffer_set(want, 720 + n, x * y)
            buffer_set(wparts, n, y.re)
            buffer_set(wparts, 144 + n, y.im)
            let mut c: i32 = 0
            if x == y:
                c = c + 1
            if x != y:
                c = c + 2
            buffer_set(wcmp, n, c)
            n = n + 1
    let dxr: Buffer[f32, (144,), device_global] = buffer_to_device(xr)
    let dxi: Buffer[f32, (144,), device_global] = buffer_to_device(xi)
    let db: Buffer[c64, (144,), device_global] = buffer_to_device(b)
    let mut dout: Buffer[c64, (864,), device_global] = buffer_to_device(sentinel)
    let mut dparts: Buffer[f32, (288,), device_global] = buffer_to_device(psentinel)
    let mut dcmp: Buffer[i32, (144,), device_global] = buffer_to_device(csentinel)
    gpu_launch(ops_c64, (n + BLOCK - 1) / BLOCK, BLOCK, n, &dxr, &dxi, &db, &mut dout, &mut dparts, &mut dcmp)
    let got: Buffer[c64, (864,)] = buffer_to_host(dout)
    let gparts: Buffer[f32, (288,)] = buffer_to_host(dparts)
    let gcmp: Buffer[i32, (144,)] = buffer_to_host(dcmp)
    let mut bad: i64 = 0
    for op: i64 in range(6):
        for i: i64 in range(n):
            let g: c64 = buffer_get(got, op * 144 + i)
            let w: c64 = buffer_get(want, op * 144 + i)
            if not same(g.re as f64, w.re as f64):
                bad = bad + report("c64 re", op, i, g.re as f64, w.re as f64)
            if not same(g.im as f64, w.im as f64):
                bad = bad + report("c64 im", op, i, g.im as f64, w.im as f64)
    for i: i64 in range(288):
        let g: f64 = buffer_get(gparts, i) as f64
        let w: f64 = buffer_get(wparts, i) as f64
        if not same(g, w):
            bad = bad + report("c64 parts", 6, i, g, w)
    for i: i64 in range(n):
        if buffer_get(gcmp, i) != buffer_get(wcmp, i):
            bad = bad + report("c64 compare", 7, i, buffer_get(gcmp, i) as f64, buffer_get(wcmp, i) as f64)
    println!("c64: {bad} mismatches")
    return bad

def main() -> i32:
    let bad: i64 = check_c64() + check_cmp_c64()
    if bad != 0:
        return 1
    println!("complex: c64 construction, re/im, + - *, conj, negation, comparisons and buffer elements match the strict host")
    return 0
