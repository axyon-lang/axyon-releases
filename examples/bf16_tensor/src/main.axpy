import std.tensor as T

# bf16 tensor storage, casts and f32-accumulating matmul (#1535). Prints 9.
def main() -> i32:
    let a32: Tensor[f32, (2, 3)] = T.full([2, 3], 1.5)
    let b32: Tensor[f32, (3, 2)] = T.full([3, 2], 2.0)
    let a: Tensor[bf16, (2, 3)] = T.cast[bf16](a32)
    let b: Tensor[bf16, (3, 2)] = T.cast[bf16](b32)
    let c: Tensor[f32, (2, 2)] = T.matmul[f32](a, b)
    let cf: Tensor[f32, (4,)] = T.flatten(c)
    println!("{}", cf[0])
    return 0
