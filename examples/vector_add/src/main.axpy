# Vector Add Example for AXYON
# Demonstrates initializing two f32 vectors and adding them together.

import std.tensor as T

def main() -> i32:
    """Entry point for the vector_add example.

    Creates two f32 vectors of size 100:
    - a: initialized to zeros
    - b: initialized to ones

    Adds them together and prints the result.
    """
    println!("Vector Add Example")
    println!("Creating two f32 vectors of size 100...")

    # Create vectors
    let a: Tensor[f32, (100,)] = T.zeros([100])
    let b: Tensor[f32, (100,)] = T.ones([100])

    # Add them together
    let c: Tensor[f32, (100,)] = T.add(a, b)

    println!("Done! Result is a tensor where each element is 1.0 (0 + 1 = 1)")
    return 0
