import std.tensor as T

def main() -> i32:
    let mut acc: Tensor[f32, (4,)] = T.full([4], 0.0)
    let x: Tensor[f32, (4,)] = T.full([4], 1.5)
    for i: i64 in range(0, 4):
        acc.add_(x)
    acc.mul_(x)
    println!("{} {} {} {}", acc[0], acc[1], acc[2], acc[3])

    let mut dst: Tensor[f32, (4,)] = T.full([4], 0.0)
    dst.copy_from(&x)
    println!("{} {}", dst[0], x[3])

    let mut cache: Tensor[f32, (4, 2)] = T.full([4, 2], 0.0)
    let kv: Tensor[f32, (1, 2)] = T.full([1, 2], 7.0)
    for pos: i64 in range(0, 4):
        cache.write_at(pos, kv)
    println!("{} {}", cache[0, 0], cache[3, 1])
    for pos: i64 in range(0, 4):
        cache[pos] = kv
    println!("{} {}", cache[0, 0], cache[3, 1])

    let mut prod: Tensor[f32, (2, 2)] = T.full([2, 2], 0.0)
    let m: Tensor[f32, (2, 3)] = T.full([2, 3], 2.0)
    let n: Tensor[f32, (3, 2)] = T.full([3, 2], 0.5)
    for step: i64 in range(0, 3):
        prod.matmul_into(m, n)
    println!("{} {}", prod[0, 0], prod[1, 1])
    return 0
